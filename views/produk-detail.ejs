<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head') %></head>
<body>
<div class="app-shell">
  <%- include('partials/user-sidebar', { active: 'produk', user, config }) %>
  <div class="main detail-main no-bottom-nav">

    <% /* Produk yang tergabung dalam Grup Varian (mis. semua nominal "Mobile Legends") harus tetap
       menampilkan nama grupnya di sini, BUKAN nama SKU spesifik yang kebetulan jadi link (varian
       termurah) dari kartu katalog. Kalau tidak, judul halaman "loncat" jadi nama nominal tertentu
       (mis. "MOBILELEGEND - 3 Diamond") padahal di beranda kartunya cuma tertulis "Mobile Legends". */ %>
    <% const displayName = product.variantGroup || product.name; %>

    <!-- Hero Image -->
    <div class="detail-hero">
      <% if (displayThumbnail) { %>
        <img class="detail-thumb" src="<%= displayThumbnail %>" alt="<%= displayName %>" onload="this.classList.add('is-loaded')">
      <% } else { %>
        <div class="detail-thumb detail-thumb-placeholder"><%= displayName.charAt(0).toUpperCase() %></div>
      <% } %>
      <div class="detail-hero-overlay"></div>
      <a href="/produk" class="detail-back-btn"><i class="fa-solid fa-arrow-left"></i> Kembali</a>
    </div>

    <div class="detail-body">

      <div class="detail-meta-row">
        <% /* Digiflazz = auto top up sistem, jadi statusnya selalu "Auto" walau tidak ada stockItems manual. */ %>
        <% const isAuto = product.provider === 'digiflazz'; %>
        <% const stockCount = product.stockItems ? product.stockItems.length : 0; %>
        <span class="nf-stock-tag <%= (isAuto || stockCount > 0) ? 'ok' : 'warn' %>"><%- (isAuto || stockCount > 0) ? '<i class="fa-solid fa-bolt"></i> Auto' : '<i class="fa-solid fa-screwdriver-wrench"></i> Manual' %></span>
        <span class="detail-category"><%= product.category || 'Umum' %></span>
      </div>

      <h1 class="detail-title"><%= displayName %></h1>

      <!-- Rating display -->
      <div class="rating-row">
        <div class="stars-display" id="ratingStars">
          <% const avgR = reviewStats.avg || 0; for(let i=1;i<=5;i++){%><span class="star <%= i<=Math.round(avgR)?'filled':'' %>">★</span><%}%>
        </div>
        <span class="rating-score" id="ratingScore"><%= avgR.toFixed(1) %></span>
        <span class="rating-count" id="ratingCount">(<%= reviewStats.count || 0 %> ulasan)</span>
      </div>

      <!-- Stats -->
      <div class="detail-stats-row">
        <div class="detail-stat">
          <div class="detail-stat-val"><%= product.totalSold || 0 %></div>
          <div class="detail-stat-label">Terjual</div>
        </div>
        <div class="detail-stat-divider"></div>
        <% if (isAuto) { %>
        <div class="detail-stat">
          <div class="detail-stat-val" style="color:var(--success);"><i class="fa-solid fa-bolt"></i> Instan</div>
          <div class="detail-stat-label">Pengiriman</div>
        </div>
        <% } else { %>
        <div class="detail-stat">
          <div class="detail-stat-val" id="statStok"><%= stockCount %></div>
          <div class="detail-stat-label">Stok</div>
        </div>
        <% } %>
      </div>

      <!-- Deskripsi / Panduan cara membeli -->
      <% if (isAuto) { %>
        <% /* Produk auto top up (Digiflazz) gak pakai deskripsi manual, tapi panduan langkah beli yang sama buat semua produk auto. */ %>
        <% let guideStep = 1; %>
        <div class="detail-section">
          <div class="detail-section-title">Cara Membeli</div>
          <ol class="buy-guide-list">
            <% if (variants && variants.length > 1) { %>
            <li class="buy-guide-item">
              <span class="buy-guide-num"><%= guideStep++ %></span>
              <span class="buy-guide-text">Pilih <b>nominal</b> yang kamu butuhkan di daftar pilihan.</span>
            </li>
            <% } %>
            <li class="buy-guide-item">
              <span class="buy-guide-num"><%= guideStep++ %></span>
              <span class="buy-guide-text">Atur <b>jumlah (qty)</b> yang mau dibeli, lalu cek total harganya.</span>
            </li>
            <% if (product.targetFields && product.targetFields.length > 0) { %>
            <li class="buy-guide-item">
              <span class="buy-guide-num"><%= guideStep++ %></span>
              <span class="buy-guide-text">Isi <b><%= product.targetFields.map(f => f.label).join(' & ') %></b> dengan benar. Data yang salah bisa bikin pesanan gagal terkirim.</span>
            </li>
            <% } %>
            <li class="buy-guide-item">
              <span class="buy-guide-num"><%= guideStep++ %></span>
              <span class="buy-guide-text">Pilih <b>metode pembayaran</b>: Saldo akun atau QRIS.</span>
            </li>
            <li class="buy-guide-item">
              <span class="buy-guide-num"><%= guideStep++ %></span>
              <span class="buy-guide-text">Klik <b>Beli Sekarang</b>. Setelah pembayaran berhasil, produk terkirim <b>otomatis & instan</b>.</span>
            </li>
          </ol>
        </div>
      <% } else if (product.description) { %>
        <div class="detail-section">
          <div class="detail-section-title">Deskripsi Produk</div>
          <div class="detail-desc"><%= product.description %></div>
        </div>
      <% } %>

      <!-- Buy Box: grid nominal & harga tampil buat SEMUA ORANG (termasuk tamu belum login).
           Cuma kontrol pembelian (qty, data tujuan, metode bayar, tombol beli) yang wajib login. -->
      <div class="detail-buy-box">

        <%
          // Nomor urutan langkah beli dihitung dinamis. "Isi Data Tujuan" (ID game / Server-Zone ID)
          // sekarang ditaruh PALING ATAS, sebelum pilih nominal -- user isi ID/Server dulu baru
          // milih nominal & bayar, urutannya lebih natural buat top up game. Nomor cuma dimunculin
          // kalau produk ini punya >1 varian nominal buat dipilih (sama kayak aturan sebelumnya).
        %>
        <% const numberSteps = !!(variants && variants.length > 1); %>
        <% const hasTargetFields = !!(product.targetFields && product.targetFields.length > 0); %>
        <% const targetFieldsLabel = (numberSteps && hasTargetFields) ? '1. ' : ''; %>
        <% const variantLabel = numberSteps ? (hasTargetFields ? '2. ' : '1. ') : ''; %>
        <% const qtyLabel = numberSteps ? (hasTargetFields ? '3. ' : '2. ') : ''; %>

        <% if (user) { %>
        <div id="targetFieldsWrap">
        <% if (hasTargetFields) { %>
        <div class="target-fields-box">
          <div class="detail-method-title"><%= targetFieldsLabel %>Isi Data Tujuan</div>
          <% product.targetFields.forEach(f => { %>
            <label><%= f.label %><% if (f.required) { %> <span style="color:var(--cyan);">*</span><% } %></label>
            <% if (f.type === 'select') { %>
              <select class="target-field-input" data-key="<%= f.key %>" <%= f.required ? 'required' : '' %>>
                <option value="">Pilih <%= f.label %></option>
                <% (f.options || []).forEach(opt => { %>
                  <option value="<%= opt.value %>"><%= opt.label %></option>
                <% }) %>
              </select>
            <% } else { %>
              <input type="text" class="target-field-input" data-key="<%= f.key %>" placeholder="<%= f.placeholder || '' %>" <%= f.required ? 'required' : '' %>>
            <% } %>
          <% }) %>
          <div class="helper-text">Pastikan data di atas benar. Kesalahan <%= product.targetFields.some(f => /zone/i.test(f.key)) ? 'ID/Zone' : 'data' %> bisa membuat pesanan gagal terkirim.</div>
        </div>
        <% } %>
        </div>
        <% } %>

        <% if (variants && variants.length > 1) { %>
        <div class="detail-method-title" <%= (user && hasTargetFields) ? '' : 'style="margin-top:0;"' %>><%= variantLabel %>Pilih Nominal</div>
        <% if (user) { %>
        <div class="variant-grid" id="variantGrid">
          <% variants.forEach(v => { %>
            <% const vIsAuto = v.provider === 'digiflazz'; %>
            <% const vOutOfStock = !vIsAuto && v.stockCount === 0; %>
            <button type="button" class="variant-card <%= v.id === product.id ? 'selected' : '' %> <%= vOutOfStock ? 'out-of-stock' : '' %>" data-variant-id="<%= v.id %>">
              <% if (v.thumbnail) { %>
                <img class="variant-card-icon" src="<%= v.thumbnail %>" alt="">
              <% } else { %>
                <div class="variant-card-icon-placeholder"><i class="fa-solid fa-gem"></i></div>
              <% } %>
              <span class="variant-card-name"><%= v.name %></span>
              <span class="variant-card-price">Rp <%= v.finalPrice.toLocaleString('id-ID') %></span>
              <% if (vOutOfStock) { %><span class="variant-card-warn">Stok habis</span><% } %>
              <div class="variant-card-badge <%= vIsAuto ? '' : 'manual' %>">
                <% if (vIsAuto) { %>
                  <i class="fa-solid fa-bolt"></i> Pengiriman INSTAN
                <% } else { %>
                  <i class="fa-solid fa-screwdriver-wrench"></i> Manual
                <% } %>
              </div>
            </button>
          <% }) %>
        </div>
        <% } else { %>
        <div class="variant-grid">
          <% variants.forEach(v => { %>
            <% const vIsAuto = v.provider === 'digiflazz'; %>
            <% const vOutOfStock = !vIsAuto && v.stockCount === 0; %>
            <a href="/produk/<%= v.id %>" class="variant-card <%= v.id === product.id ? 'selected' : '' %>">
              <% if (v.thumbnail) { %>
                <img class="variant-card-icon" src="<%= v.thumbnail %>" alt="">
              <% } else { %>
                <div class="variant-card-icon-placeholder"><i class="fa-solid fa-gem"></i></div>
              <% } %>
              <span class="variant-card-name"><%= v.name %></span>
              <span class="variant-card-price">Rp <%= v.finalPrice.toLocaleString('id-ID') %></span>
              <% if (vOutOfStock) { %><span class="variant-card-warn">Stok habis</span><% } %>
              <div class="variant-card-badge <%= vIsAuto ? '' : 'manual' %>">
                <% if (vIsAuto) { %>
                  <i class="fa-solid fa-bolt"></i> Pengiriman INSTAN
                <% } else { %>
                  <i class="fa-solid fa-screwdriver-wrench"></i> Manual
                <% } %>
              </div>
            </a>
          <% }) %>
        </div>
        <% } %>
        <% } %>

        <div class="detail-price-main">
          <span class="detail-price-now" id="priceNow">Rp <%= finalPrice.toLocaleString('id-ID') %></span>
        </div>

        <% if (user) { %>
          <div class="detail-qty-row">
            <label><%= qtyLabel %>Jumlah:</label>
            <div class="qty-stepper">
              <button type="button" class="qty-btn" id="qtyMinus">−</button>
              <input type="number" id="qtyInput" value="1" min="1" max="<%= (!isAuto && stockCount > 0) ? stockCount : (isAuto ? maxDigiflazzQty : 99) %>">
              <button type="button" class="qty-btn" id="qtyPlus">+</button>
            </div>
            <span class="total-preview">= <span class="total-preview-old" id="totalPreviewOld" style="display:none;"></span><b id="totalPreview">Rp <%= finalPrice.toLocaleString('id-ID') %></b></span>
          </div>

          <% const qrisFeePercent = (config.qris && config.qris.feePercent != null) ? config.qris.feePercent : 0.7; %>
          <div class="detail-method-title">Metode Pembayaran</div>
          <div class="payment-method-tabs">
            <label class="method-tab">
              <input type="radio" name="payMethod" value="saldo" checked>
              <div class="method-card">
                <div class="method-card-top">
                  <div class="method-icon"><i class="fa-solid fa-wallet"></i></div>
                  <div class="method-info">
                    <div class="method-name">Saldo Akun</div>
                    <div class="method-sub">Saldo kamu: <b>Rp <%= user.saldo.toLocaleString('id-ID') %></b></div>
                  </div>
                  <div class="method-check"><i class="fa-solid fa-check"></i></div>
                </div>
                <div class="method-tag success"><i class="fa-solid fa-bolt"></i> Tanpa biaya tambahan</div>
              </div>
            </label>
            <label class="method-tab">
              <input type="radio" name="payMethod" value="qris">
              <div class="method-card">
                <div class="method-card-top">
                  <div class="method-icon"><i class="fa-solid fa-qrcode"></i></div>
                  <div class="method-info">
                    <div class="method-name">QRIS</div>
                    <div class="method-sub">GoPay, OVO, DANA, ShopeePay, m-Banking</div>
                  </div>
                  <div class="method-check"><i class="fa-solid fa-check"></i></div>
                </div>
                <div class="method-tag">Biaya admin ~<%= qrisFeePercent %>%</div>
              </div>
            </label>
          </div>

          <div class="detail-method-title">Kode Promo <span style="text-transform:none; font-weight:400; letter-spacing:normal;">(opsional)</span></div>
          <div class="promo-box" id="promoBox">
            <div class="promo-input-row" id="promoInputRow">
              <input type="text" id="promoInput" class="promo-input" placeholder="Masukkan kode promo" maxlength="20" autocomplete="off">
              <button type="button" class="promo-apply-btn" id="promoApplyBtn">Terapkan</button>
            </div>
            <div class="promo-applied-row" id="promoAppliedRow" style="display:none;">
              <div class="promo-applied-info"><i class="fa-solid fa-circle-check"></i> <span>Kode <b id="promoAppliedCode"></b> aktif — hemat <b id="promoAppliedAmount"></b></span></div>
              <button type="button" class="promo-remove-btn" id="promoRemoveBtn" aria-label="Hapus kode promo"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="promo-msg" id="promoMsg"></div>
          </div>

          <form method="POST" action="/order" id="buyFormSaldo">
            <input type="hidden" name="productId" id="productIdSaldo" value="<%= product.id %>">
            <input type="hidden" name="qty" id="buyQtySaldo" value="1">
            <input type="hidden" name="promoCode" id="promoCodeSaldo" value="">
          </form>
          <form method="POST" action="/order/qris-init" id="buyFormQris">
            <input type="hidden" name="productId" id="productIdQris" value="<%= product.id %>">
            <input type="hidden" name="qty" id="buyQtyQris" value="1">
            <input type="hidden" name="promoCode" id="promoCodeQris" value="">
          </form>

          <div class="alert error" id="saldoWarning" style="margin-top:8px; font-size:12px; <%= user.saldo < finalPrice ? '' : 'display:none;' %>">Saldo tidak cukup — gunakan QRIS.</div>
        <% } else { %>
          <div class="guest-buy-box" style="display:none;">
            <a href="/login" class="btn solid" style="width:100%;"><i class="fa-solid fa-key"></i> Login untuk Beli</a>
            <div style="text-align:center; margin-top:10px; font-size:12px; color:var(--text-dim);">Belum punya akun? <a href="/register" style="color:var(--cyan);">Daftar gratis</a></div>
          </div>
        <% } %>
      </div>

      <!-- ====== ULASAN / KOMENTAR ======
           Sekarang GLOBAL PER GRUP (semua nominal game yang sama berbagi ulasan & rating yang
           sama) -- gak lagi beda-beda/di-swap JS per varian nominal kayak versi sebelumnya,
           makanya gak ada lagi elemen yang perlu di-refresh pas ganti pilihan nominal di bawah. -->
      <div class="reviews-section">
        <div class="reviews-header">
          <div class="detail-section-title">Ulasan Pembeli</div>
          <span class="reviews-count"><%= reviewStats.count %> ulasan</span>
        </div>

        <% if (reviewStats.count > 0) { %>
        <div class="rating-breakdown">
          <div class="rb-avg">
            <div class="rb-avg-num"><%= reviewStats.avg.toFixed(1) %></div>
            <div class="rb-avg-stars"><% for(let i=1;i<=5;i++){%><span class="star <%= i<=Math.round(reviewStats.avg)?'filled':'' %>">★</span><%}%></div>
            <div class="rb-avg-count"><%= reviewStats.count %> ulasan</div>
          </div>
          <div class="rb-bars">
            <% for (let star = 5; star >= 1; star--) {
                 const n = reviewStats.breakdown[star] || 0;
                 const pct = reviewStats.count > 0 ? Math.round((n / reviewStats.count) * 100) : 0; %>
            <div class="rb-bar-row">
              <span class="rb-bar-label"><%= star %> <i class="fa-solid fa-star"></i></span>
              <span class="rb-bar-track"><span class="rb-bar-fill" style="width:<%= pct %>%"></span></span>
              <span class="rb-bar-count"><%= n %></span>
            </div>
            <% } %>
          </div>
        </div>
        <% } %>

        <!-- Form ulasan: 4 kemungkinan kondisi -- belum login, sudah login tapi belum pernah beli
             produk ini (paling umum), sudah beli tapi udah pernah ngasih ulasan, atau boleh nulis. -->
        <div id="reviewFormWrap">
        <% if (!user) { %>
          <div class="review-login-prompt"><a href="/login" style="color:var(--cyan);">Login</a> untuk menulis ulasan.</div>
        <% } else if (hasReviewed) { %>
          <div class="review-already"><i class="fa-solid fa-circle-check"></i> Kamu sudah memberikan ulasan untuk produk ini.</div>
        <% } else if (!canReview) { %>
          <div class="review-login-prompt"><i class="fa-solid fa-lock"></i> Beli & selesaikan pesanan produk ini dulu sebelum bisa kasih ulasan.</div>
        <% } else { %>
          <div class="review-form-card">
            <div class="review-form-title">Tulis Ulasanmu</div>
            <form method="POST" action="/produk/<%= product.id %>/review" class="review-form" id="reviewForm">
              <div class="review-stars-input" id="reviewStarsInput">
                <% for(let i=1;i<=5;i++){%><span class="rev-star-btn" data-val="<%= i %>">★</span><%}%>
              </div>
              <input type="hidden" name="rating" id="reviewRatingVal" value="">
              <p class="rev-star-hint" id="revStarHint">Ketuk bintang untuk memberi nilai</p>
              <textarea name="comment" class="review-textarea" placeholder="Ceritakan pengalamanmu menggunakan produk ini... (opsional, maks 500 karakter)" maxlength="500" rows="3"></textarea>
              <button type="submit" class="btn solid review-submit-btn" id="reviewSubmitBtn" disabled>Kirim Ulasan</button>
            </form>
          </div>
        <% } %>
        </div>

        <!-- Daftar ulasan -- geser horizontal otomatis (marquee) kalau ulasannya banyak (>=4),
             berhenti sebentar pas disentuh/di-hover biar tetap kebaca nyaman. -->
        <% if (reviews.length === 0) { %>
          <div class="reviews-empty">Belum ada ulasan. Jadilah yang pertama! <i class="fa-solid fa-star"></i></div>
        <% } else { %>
          <div class="review-marquee-wrap">
            <div class="review-marquee-track <%= reviews.length >= 4 ? 'is-scrolling' : '' %>">
              <% const marqueeReviews = reviews.length >= 4 ? reviews.concat(reviews) : reviews; %>
              <% marqueeReviews.forEach(r => { %>
              <div class="review-card">
                <div class="review-card-top">
                  <div class="review-avatar"><%= r.username.charAt(0).toUpperCase() %></div>
                  <div class="review-card-meta">
                    <div class="review-username"><%= r.username %></div>
                    <div class="review-date"><%= new Date(r.createdAt).toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'}) %></div>
                  </div>
                  <div class="review-stars-display">
                    <% for(let i=1;i<=5;i++){%><span class="<%= i<=r.rating?'rstar-on':'rstar-off' %>">★</span><%}%>
                  </div>
                </div>
                <% if (r.comment) { %>
                  <div class="review-comment"><%= r.comment %></div>
                <% } %>
              </div>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>

    </div><!-- /detail-body -->
    <%- include('partials/footer') %>

    <!-- ====== STICKY BUY BAR ======
         Harga + tombol "Beli Sekarang" digabung jadi 1 bar yang nempel di bawah layar (nama
         varian yang lagi dipilih + harga di kiri, tombol beli bulat besar di kanan) -- biar
         selalu kelihatan & gampang diklik tanpa perlu scroll balik ke atas, walau user udah
         scroll jauh ke bagian ulasan. Tombol beli yang ASLI (id="buyMainBtn", listener klik-nya
         di script bawah) dipindah ke sini -- listener-nya cari elemen by ID jadi tetap jalan
         normal walau posisinya di DOM udah beda dari sebelumnya. -->
    <div class="detail-buy-stickybar">
      <div class="dbs-inner">
        <div class="dbs-info">
          <div class="dbs-name" id="dbsName"><%= (variants && variants.length > 1) ? product.name : displayName %></div>
          <% if (product.price > finalPrice) { %>
          <div class="dbs-old-price" id="dbsOldPrice">Rp <%= product.price.toLocaleString('id-ID') %></div>
          <% } %>
          <div class="dbs-price" id="dbsPrice">Rp <%= finalPrice.toLocaleString('id-ID') %></div>
        </div>
        <% if (user) { %>
          <button type="button" class="dbs-buy-btn" id="buyMainBtn"><i class="fa-solid fa-cart-shopping"></i> Beli Sekarang</button>
        <% } else { %>
          <a href="/login" class="dbs-buy-btn" style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center;"><i class="fa-solid fa-key"></i> Login untuk Beli</a>
        <% } %>
      </div>
    </div>
  </div><!-- /main -->
</div><!-- /app-shell -->

<script>
(function(){
  var VARIANTS = <%- JSON.stringify((variants || []).reduce(function(acc, v){ acc[v.id] = v; return acc; }, {})) %>;
  var userSaldo = <%= user ? user.saldo : 0 %>;
  var currentProductId = '<%= product.id %>';
  // Isi Data Tujuan selalu di posisi PALING ATAS di box beli (lihat markup di atas), jadi kalau
  // nomor langkah lagi dipakai (produk ini punya >1 varian nominal), section itu selalu "1."
  // -- termasuk pas dimunculin ulang lewat JS ini waktu user ganti pilihan varian.
  var numberSteps = <%- numberSteps ? 'true' : 'false' %>;
  // Batas qty produk auto top up (Digiflazz), sama persis dengan MAX_DIGIFLAZZ_QTY_PER_ORDER
  // di routes/user.js (dikirim dari server lewat maxDigiflazzQty biar gak ada 2 angka beda tempat).
  var MAX_DIGIFLAZZ_QTY = <%= maxDigiflazzQty %>;

  // Qty stepper
  var unitPrice=<%= finalPrice %>;
  var qEl=document.getElementById('qtyInput');
  var tEl=document.getElementById('totalPreview');
  function fmt(n){return 'Rp '+n.toLocaleString('id-ID');}

  // ---- Kode Promo: state-nya cuma persentase + kode yang lagi aktif di halaman ini. Dihitung
  // ULANG tiap kali qty/varian berubah (upd() di bawah) karena diskonnya % dari TOTAL, bukan
  // potongan tetap -- jadi nominal "hemat Rp X" ikut naik/turun sesuai qty & varian yang dipilih.
  // Validasi SEBENARNYA (kode ada/tidak, kuota, sudah pernah dipakai) tetap di server lewat
  // POST /promo/validate & divalidasi ULANG lagi pas submit checkout -- angka di sini murni
  // buat preview, bukan sumber kebenaran.
  var promoPercent = 0;
  var promoCodeApplied = '';

  // q di-clamp ke MIN 1 *dan* MAX (dari atribut max input) -- sebelumnya cuma di-clamp ke 1,
  // jadi tombol "+" atau ketik manual bisa lewatin batas stok/limit Digiflazz begitu aja di
  // layar (total harga ikut naik seolah valid), baru ketahuan gagal pas klik "Beli Sekarang"
  // dan server (validateQty) nolak. Sekarang batasnya ditegakkan dari awal di sisi tampilan.
  function upd(){
    var max=parseInt(qEl.max,10);
    if(!max || max<1) max=99;
    var q=Math.max(1,Math.min(max,parseInt(qEl.value)||1));
    qEl.value=q;
    var qs=document.getElementById('buyQtySaldo');var qq=document.getElementById('buyQtyQris');
    if(qs)qs.value=q;if(qq)qq.value=q;

    var rawTotal = unitPrice*q;
    var discount = promoPercent > 0 ? Math.round(rawTotal * promoPercent / 100) : 0;
    var finalTotal = rawTotal - discount;

    if(tEl) tEl.textContent=fmt(finalTotal);
    var tOld=document.getElementById('totalPreviewOld');
    if(tOld){
      if(discount > 0){ tOld.textContent=fmt(rawTotal); tOld.style.display=''; }
      else { tOld.style.display='none'; }
    }
    var promoAppliedAmount=document.getElementById('promoAppliedAmount');
    if(promoAppliedAmount) promoAppliedAmount.textContent=fmt(discount);

    updSaldoWarning(finalTotal);
  }
  function updSaldoWarning(total){
    var warn=document.getElementById('saldoWarning');
    if(!warn) return;
    warn.style.display = (userSaldo < total) ? '' : 'none';
  }
  if(qEl){qEl.addEventListener('input',upd);
    var m=document.getElementById('qtyMinus');var p=document.getElementById('qtyPlus');
    if(m)m.addEventListener('click',function(){qEl.value=Math.max(1,(parseInt(qEl.value)||1)-1);upd();});
    if(p)p.addEventListener('click',function(){qEl.value=(parseInt(qEl.value)||1)+1;upd();});}

  // ---- Kode Promo: terapkan / hapus ----
  (function(){
    var input=document.getElementById('promoInput');
    var applyBtn=document.getElementById('promoApplyBtn');
    var removeBtn=document.getElementById('promoRemoveBtn');
    var inputRow=document.getElementById('promoInputRow');
    var appliedRow=document.getElementById('promoAppliedRow');
    var appliedCode=document.getElementById('promoAppliedCode');
    var msg=document.getElementById('promoMsg');
    if(!input || !applyBtn) return;

    function setHiddenFields(code){
      var ps=document.getElementById('promoCodeSaldo'); var pq=document.getElementById('promoCodeQris');
      if(ps)ps.value=code; if(pq)pq.value=code;
    }

    function applyPromo(){
      var code=(input.value||'').trim();
      if(!code){ msg.textContent='Masukkan kode promonya dulu'; return; }
      applyBtn.disabled=true;
      var originalLabel=applyBtn.textContent;
      applyBtn.textContent='Mengecek...';
      fetch('/promo/validate', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ code: code })
      }).then(function(r){ return r.json(); }).then(function(data){
        applyBtn.disabled=false;
        applyBtn.textContent=originalLabel;
        if(!data.valid){
          msg.textContent = data.reason || 'Kode promo tidak valid';
          return;
        }
        promoPercent = data.discountPercent;
        promoCodeApplied = data.code;
        msg.textContent='';
        setHiddenFields(promoCodeApplied);
        if(appliedCode) appliedCode.textContent = promoCodeApplied + ' (-' + promoPercent + '%)';
        if(inputRow) inputRow.style.display='none';
        if(appliedRow) appliedRow.style.display='flex';
        upd();
        showToast('Kode ' + promoCodeApplied + ' berhasil dipakai.', { type: 'success', title: 'Promo diterapkan' });
      }).catch(function(){
        applyBtn.disabled=false;
        applyBtn.textContent=originalLabel;
        msg.textContent='Gagal menghubungi server, coba lagi';
      });
    }

    function removePromo(){
      promoPercent = 0;
      promoCodeApplied = '';
      setHiddenFields('');
      input.value='';
      msg.textContent='';
      if(inputRow) inputRow.style.display='flex';
      if(appliedRow) appliedRow.style.display='none';
      upd();
    }

    applyBtn.addEventListener('click', applyPromo);
    if(removeBtn) removeBtn.addEventListener('click', removePromo);
    input.addEventListener('keydown', function(e){ if(e.key==='Enter'){ e.preventDefault(); applyPromo(); } });
  })();

  // Ganti varian nominal (mis. pilih 875 Diamonds vs 2010 Diamonds) tanpa reload halaman
  function renderTargetFields(fields){
    var wrap=document.getElementById('targetFieldsWrap');
    if(!wrap) return;
    if(!fields || fields.length===0){ wrap.innerHTML=''; return; }
    var label = numberSteps ? '1. ' : '';
    var html='<div class="target-fields-box"><div class="detail-method-title">'+label+'Isi Data Tujuan</div>';
    fields.forEach(function(f){
      html+='<label>'+f.label+(f.required?' <span style="color:var(--cyan);">*</span>':'')+'</label>';
      if(f.type==='select'){
        html+='<select class="target-field-input" data-key="'+f.key+'" '+(f.required?'required':'')+'>';
        html+='<option value="">Pilih '+f.label+'</option>';
        (f.options||[]).forEach(function(opt){
          html+='<option value="'+opt.value+'">'+opt.label+'</option>';
        });
        html+='</select>';
      } else {
        html+='<input type="text" class="target-field-input" data-key="'+f.key+'" placeholder="'+(f.placeholder||'')+'" '+(f.required?'required':'')+'>';
      }
    });
    var hasZoneField = fields.some(function(f){ return /zone/i.test(f.key); });
    html+='<div class="helper-text">Pastikan data di atas benar. Kesalahan '+(hasZoneField?'ID/Zone':'data')+' bisa membuat pesanan gagal terkirim.</div></div>';
    wrap.innerHTML=html;
  }

  // ---- Toast notification, pengganti alert() bawaan browser yang keliatan murahan ----
  function showToast(msg, opts){
    opts = opts || {};
    var type = opts.type || 'error';
    var title = opts.title || (type === 'error' ? 'Belum lengkap' : type === 'success' ? 'Berhasil' : 'Info');
    var duration = opts.duration || 3800;
    var icon = type === 'error' ? 'fa-triangle-exclamation' : type === 'success' ? 'fa-circle-check' : 'fa-circle-info';

    var stack = document.getElementById('toastStack');
    if (!stack) {
      stack = document.createElement('div');
      stack.id = 'toastStack';
      stack.className = 'toast-stack';
      document.body.appendChild(stack);
    }

    var card = document.createElement('div');
    card.className = 'toast-card ' + type;
    card.innerHTML =
      '<div class="toast-icon"><i class="fa-solid ' + icon + '"></i></div>' +
      '<div class="toast-body"><div class="toast-title"></div><div class="toast-msg"></div></div>' +
      '<button type="button" class="toast-close" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>' +
      '<div class="toast-progress"></div>';
    // textContent (bukan innerHTML) buat title/msg -- aman walau pesannya nanti dari input user.
    card.querySelector('.toast-title').textContent = title;
    card.querySelector('.toast-msg').textContent = msg;
    card.querySelector('.toast-progress').style.animationDuration = duration + 'ms';
    stack.appendChild(card);

    var timer = setTimeout(remove, duration);
    card.querySelector('.toast-close').addEventListener('click', function(){ clearTimeout(timer); remove(); });

    function remove(){
      card.classList.add('toast-out');
      card.addEventListener('animationend', function(){ card.remove(); }, { once: true });
    }
  }

  // ---- Form ulasan: klik bintang buat kasih nilai ----
  // Sebelumnya bagian ini juga ngurusin "rating & ulasan ikut ganti pas user pilih nominal lain"
  // (dengan nge-render ulang <div id="reviewFormWrap">/reviewListWrap lewat JS pas klik varian) --
  // itu sekarang GAK PERLU LAGI karena ulasan sudah global per grup (lihat lib/reviews.js), jadi
  // rating/daftar ulasan/status "sudah pernah review atau belum" SELALU SAMA gak peduli nominal
  // mana yang lagi dipilih -- gak perlu di-refresh sama sekali pas ganti varian.
  function wireReviewForm(){
    var form=document.getElementById('reviewForm');
    if(!form) return;
    var stars=form.querySelectorAll('.rev-star-btn');
    var ratingInput=document.getElementById('reviewRatingVal');
    var hint=document.getElementById('revStarHint');
    var submitBtn=document.getElementById('reviewSubmitBtn');
    var labels=['Sangat Buruk','Kurang Baik','Cukup','Bagus Sekali','Luar Biasa!'];
    stars.forEach(function(s){
      s.addEventListener('mouseenter',function(){
        var v=parseInt(s.dataset.val);
        stars.forEach(function(x){x.classList.toggle('hov',parseInt(x.dataset.val)<=v);});
        if(hint)hint.textContent=labels[v-1];
      });
      s.addEventListener('mouseleave',function(){
        stars.forEach(function(x){x.classList.remove('hov');});
        if(hint&&!ratingInput.value)hint.textContent='Ketuk bintang untuk memberi nilai';
      });
      s.addEventListener('click',function(){
        var v=parseInt(s.dataset.val);
        if(ratingInput)ratingInput.value=v;
        stars.forEach(function(x){x.classList.toggle('sel',parseInt(x.dataset.val)<=v);x.classList.remove('hov');});
        if(hint)hint.textContent=labels[v-1];
        if(submitBtn)submitBtn.disabled=false;
      });
    });
  }

  var variantGrid=document.getElementById('variantGrid');
  if(variantGrid){
    variantGrid.addEventListener('click',function(e){
      var card=e.target.closest('.variant-card');
      if(!card) return;
      var vid=card.dataset.variantId;
      var v=VARIANTS[vid];
      if(!v) return;

      currentProductId=vid;
      unitPrice=v.finalPrice;

      variantGrid.querySelectorAll('.variant-card').forEach(function(c){c.classList.remove('selected');});
      card.classList.add('selected');

      var priceNow=document.getElementById('priceNow');
      if(priceNow) priceNow.textContent=fmt(v.finalPrice);

      // FIX BUG: stat "Stok" di baris atas (dekat nama produk) sebelumnya gak ikut ke-update
      // pas ganti nominal. Stat "Harga" di baris ini sudah DIHAPUS (dulu duplikat sama harga
      // yang tampil di kotak beli bawah & sticky bar). "Terjual" SENGAJA gak disentuh di sini --
      // levelnya per GRUP (sama kayak Rating), bukan per nominal, jadi angkanya emang harus
      // tetap sama berapa pun nominal yang dipilih.
      var statStok=document.getElementById('statStok');
      if(statStok) statStok.textContent=(typeof v.stockCount==='number') ? v.stockCount : '-';

      // Sticky buy bar (nama varian + harga di bar bawah) ikut di-refresh juga
      var dbsName=document.getElementById('dbsName');
      if(dbsName) dbsName.textContent=v.name;
      var dbsPrice=document.getElementById('dbsPrice');
      if(dbsPrice) dbsPrice.textContent=fmt(v.finalPrice);
      var dbsOldPrice=document.getElementById('dbsOldPrice');
      if(v.price>v.finalPrice){
        if(!dbsOldPrice){
          dbsOldPrice=document.createElement('div');
          dbsOldPrice.className='dbs-old-price';
          dbsOldPrice.id='dbsOldPrice';
          dbsName.insertAdjacentElement('afterend',dbsOldPrice);
        }
        dbsOldPrice.textContent=fmt(v.price);
      } else if(dbsOldPrice){
        dbsOldPrice.remove();
      }

      var idSaldo=document.getElementById('productIdSaldo');
      var idQris=document.getElementById('productIdQris');
      if(idSaldo)idSaldo.value=vid;
      if(idQris)idQris.value=vid;

      if(qEl){
        // Sebelumnya varian Digiflazz jatuh ke cabang "else 99" di sini (cuma dicek
        // "provider !== 'digiflazz'"), padahal saat halaman pertama dimuat batasnya 10
        // (MAX_DIGIFLAZZ_QTY). Efeknya: ganti nominal bikin batas qty diam-diam melonggar
        // dari 10 ke 99. Sekarang provider digiflazz SELALU pakai MAX_DIGIFLAZZ_QTY dulu.
        qEl.value=1;
        qEl.max = (v.provider === 'digiflazz') ? MAX_DIGIFLAZZ_QTY : (v.stockCount>0 ? v.stockCount : 99);
      }
      upd();

      renderTargetFields(v.targetFields);
    });
  }

  // Method tabs
  var radios=document.querySelectorAll('input[name="payMethod"]');
  radios.forEach(function(r){r.addEventListener('change',function(){
    document.querySelectorAll('.method-card').forEach(function(c){c.classList.remove('selected');});
    r.closest('.method-tab').querySelector('.method-card').classList.add('selected');
  });});
  var def=document.querySelector('input[name="payMethod"]:checked');
  if(def)def.closest('.method-tab').querySelector('.method-card').classList.add('selected');

  // Buy button
  var buyBtn=document.getElementById('buyMainBtn');
  function injectTargetFields(form){
    if(!form) return true;
    // Bersihkan hidden input target_ lama biar gak dobel kalau user submit lebih dari sekali
    form.querySelectorAll('input[data-target-hidden]').forEach(function(el){el.remove();});
    var inputs=document.querySelectorAll('.target-field-input');
    var ok=true;
    inputs.forEach(function(el){
      var val=el.value.trim();
      if(el.hasAttribute('required') && !val){ el.style.borderColor='var(--cyan)'; ok=false; }
      else { el.style.borderColor=''; }
      var hidden=document.createElement('input');
      hidden.type='hidden';
      hidden.name='target_'+el.dataset.key;
      hidden.value=val;
      hidden.setAttribute('data-target-hidden','1');
      form.appendChild(hidden);
    });
    return ok;
  }
  if(buyBtn)buyBtn.addEventListener('click',function(){
    var m='saldo';radios.forEach(function(r){if(r.checked)m=r.value;});
    var f=m==='qris'?document.getElementById('buyFormQris'):document.getElementById('buyFormSaldo');
    if(!injectTargetFields(f)){ showToast('Lengkapi dulu data tujuan yang wajib diisi (tanda *)'); return; }
    if(f)f.submit();
  });

  // Pasang listener bintang buat form ulasan (dirender statis oleh server, gak lagi disuntik/
  // di-refresh JS pas ganti nominal -- lihat catatan lengkap di wireReviewForm() di atas).
  wireReviewForm();
})();
</script>
</body>
</html>
