<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head') %></head>
<body>
<div class="app-shell">
  <%- include('partials/user-sidebar', { active: 'profile' }) %>

  <div class="main no-bottom-nav">
    <div class="topbar"><h2>Profil Saya</h2></div>

    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert success"><%= success %></div><% } %>

    <div class="card avatar-card">
      <div class="avatar-card-preview">
        <% if (user.avatar) { %>
          <img src="<%= user.avatar %>" alt="<%= user.username %>">
        <% } else { %>
          <span class="avatar-initial"><%= (user.username || '?').charAt(0).toUpperCase() %></span>
        <% } %>
      </div>
      <div class="avatar-card-form">
        <h3 style="margin-bottom:2px;">Foto Profil</h3>
        <div class="helper-text" style="margin-top:0;">JPG, PNG, WEBP, atau GIF, maksimal 2MB. Foto ini tampil bulat di pojok kanan atas.</div>
        <form method="POST" action="/profile/avatar" enctype="multipart/form-data" class="avatar-form">
          <input type="file" name="avatarFile" accept="image/jpeg,image/png,image/webp,image/gif" required>
          <button class="btn small solid mt-16" type="submit">Ganti Foto</button>
        </form>
      </div>
    </div>

    <div class="grid grid-3">
      <div class="card stat-card">
        <div class="label">Saldo Aktif</div>
        <div class="value">Rp <%= user.saldo.toLocaleString('id-ID') %></div>
        <div class="flex" style="gap:8px;">
          <a href="/topup" class="btn small solid">+ Top Up</a>
          <a href="/riwayat-saldo" class="btn small ghost">Riwayat Saldo</a>
        </div>
      </div>
      <div class="card stat-card magenta">
        <div class="label">Total Order</div>
        <div class="value"><%= totalOrder %></div>
      </div>
      <div class="card stat-card success">
        <div class="label">Total Pembelanjaan</div>
        <div class="value">Rp <%= totalSpent.toLocaleString('id-ID') %></div>
      </div>
    </div>

    <div class="section-title"><h3>Order Terbaru</h3><div class="line"></div></div>
    <div class="card">
      <% if (recentOrders.length === 0) { %>
        <div class="empty-state">Belum ada order. <a href="/produk" style="color:var(--cyan)">Mulai belanja →</a></div>
      <% } else { %>
      <table>
        <thead><tr><th>ID</th><th>Produk</th><th>Total</th><th>Status</th><th>Tanggal</th></tr></thead>
        <tbody>
          <% recentOrders.forEach(o => { %>
          <tr>
            <td class="mono"><%= o.id %></td>
            <td><%= o.productName %></td>
            <td class="mono">Rp <%= o.total.toLocaleString('id-ID') %></td>
            <td><span class="badge <%= o.status %>"><%= o.status %></span></td>
            <td><%= new Date(o.createdAt).toLocaleString('id-ID') %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>

    <div class="section-title"><h3>Akun</h3><div class="line"></div></div>
    <div class="grid grid-2">
      <div class="card">
        <h3>Informasi Akun</h3>
        <form method="POST" action="/profile">
          <label>Username</label>
          <input type="text" value="<%= user.username %>" disabled>
          <label>Email</label>
          <input type="email" name="email" value="<%= user.email || '' %>">
          <label>Saldo</label>
          <input type="text" value="Rp <%= user.saldo.toLocaleString('id-ID') %>" disabled class="mono">
          <label>Status Member</label>
          <input type="text" value="<%= currentTier.icon %> <%= currentTier.label %>" disabled>
          <button class="btn solid mt-24" type="submit">Simpan Perubahan</button>
        </form>
      </div>

      <div class="card">
        <h3><%= user.password ? 'Ganti Password' : 'Buat Password' %></h3>
        <% if (!user.password) { %>
          <div class="helper-text" style="margin-top:0;">Akun kamu terdaftar lewat Google dan belum punya password lokal. Buat password di sini kalau mau juga bisa masuk pakai username &amp; password (opsional).</div>
        <% } %>
        <form method="POST" action="/profile/password">
          <% if (user.password) { %>
          <label>Password Lama</label>
          <input type="password" name="oldPassword" required>
          <% } %>
          <label>Password Baru</label>
          <input type="password" name="newPassword" required minlength="6">
          <label>Konfirmasi Password Baru</label>
          <input type="password" name="newPassword2" required minlength="6">
          <button class="btn magenta mt-24" type="submit"><%= user.password ? 'Update Password' : 'Buat Password' %></button>
        </form>
      </div>
    </div>

    <div class="section-title"><h3>Login Google</h3><div class="line"></div></div>
    <% const googleReady = !!(config.google && config.google.enabled && config.google.clientId && config.google.clientSecret); %>
    <div class="card">
      <div class="connected-account-row">
        <div class="connected-account-info">
          <i class="fa-brands fa-google"></i>
          <div>
            <div style="font-weight:600;"><%= user.googleId ? 'Akun Google terhubung' : 'Akun Google belum terhubung' %></div>
            <div class="helper-text" style="margin:2px 0 0;"><% if (user.googleId) { %>Kamu bisa masuk pakai tombol "Masuk dengan Google" di halaman login.<% } else if (googleReady) { %>Hubungkan supaya bisa masuk tanpa ketik username &amp; password.<% } else { %>Login Google belum diaktifkan oleh admin.<% } %></div>
          </div>
        </div>
        <% if (user.googleId) { %>
          <form method="POST" action="/profile/google/disconnect" onsubmit="return confirm('Putuskan akun Google dari profil ini? Kamu tetap bisa masuk pakai username &amp; password.');" style="margin:0;">
            <button class="btn small ghost" type="submit">Putuskan</button>
          </form>
        <% } else if (googleReady) { %>
          <a href="/auth/google" class="btn small solid">Hubungkan Google</a>
        <% } %>
      </div>
    </div>

    <div class="section-title"><h3>API Reseller</h3><div class="line"></div></div>
    <div class="card">
      <div class="helper-text" style="margin-bottom:12px;">
        Transaksi otomatis lewat API untuk integrasi bot/website kamu sendiri. Semua harga produk lewat API ini otomatis dihitung pakai harga <b>tier Platinum</b>, berapapun membership akun kamu sebenarnya.
      </div>
      <% if (user.apiKey) { %>
        <label style="font-size:13px; font-weight:600; display:block; margin-bottom:6px;">API Key kamu</label>
        <div class="flex" style="gap:8px; align-items:center; flex-wrap:wrap;">
          <input type="text" id="apiKeyField" value="<%= user.apiKey %>" readonly
                 style="flex:1; min-width:220px; font-family:monospace; font-size:13px;">
          <button type="button" class="btn small ghost" id="apiKeyCopyBtn" onclick="copyApiKey()">Salin</button>
        </div>
        <div class="helper-text" style="margin:8px 0 16px;">Jangan bagikan key ini ke siapa pun -- siapa pun yang pegang key ini bisa transaksi pakai saldo akun kamu. Kalau merasa bocor, langsung generate ulang di bawah.</div>
        <div class="flex" style="gap:8px; flex-wrap:wrap;">
          <form method="POST" action="/profile/api-key/generate" onsubmit="return confirm('Generate ulang API key? Key yang lama langsung berhenti berfungsi, integrasi yang masih pakai key lama harus diperbarui.')" style="margin:0;">
            <button class="btn small ghost" type="submit">Generate Ulang</button>
          </form>
          <form method="POST" action="/profile/api-key/revoke" onsubmit="return confirm('Cabut API key? Semua integrasi yang pakai key ini langsung berhenti bisa akses.')" style="margin:0;">
            <button class="btn small danger" type="submit">Cabut API Key</button>
          </form>
        </div>

        <div class="line" style="margin:16px 0;"></div>
        <label style="font-size:13px; font-weight:600; display:block; margin-bottom:6px;">Contoh Pemakaian</label>
        <div class="helper-text" style="margin-bottom:6px;">Base URL: <code><%= apiBaseUrl %></code> &middot; kirim key lewat header <code>X-API-Key</code></div>
        <pre style="background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.08); border-radius:8px; padding:12px; font-size:12px; overflow-x:auto; margin:0;">curl <%= apiBaseUrl %>/pricelist \
  -H "X-API-Key: <%= user.apiKey %>"

curl -X POST <%= apiBaseUrl %>/order \
  -H "X-API-Key: <%= user.apiKey %>" \
  -H "Content-Type: application/json" \
  -d '{"product_id":"ID_PRODUK","qty":1,"target":{"user_id":"12345"},"ref_id":"order-saya-001"}'</pre>
        <p style="margin:10px 0 0;"><a href="/dokumentasi-api" style="color:var(--cyan);"><i class="fa-solid fa-book"></i> Lihat dokumentasi API lengkap</a> (semua endpoint: produk, transaksi, deposit, cek saldo)</p>
      <% } else { %>
        <p style="margin:0 0 12px; font-size:14px;">Kamu belum punya API key.</p>
        <form method="POST" action="/profile/api-key/generate" style="margin:0;">
          <button class="btn small solid" type="submit">Generate API Key</button>
        </form>
      <% } %>
    </div>

    <div class="section-title"><h3>Membership</h3><div class="line"></div></div>
    <div class="grid grid-3">
      <% membershipList.filter(t => t.key !== 'reguler').forEach(t => { %>
        <div class="card member-card member-<%= t.key %>">
          <div class="member-card-icon"><%= t.icon %></div>
          <div class="member-card-title"><%= t.label %></div>
          <div class="member-card-price">Rp <%= t.price.toLocaleString('id-ID') %></div>
          <div class="member-card-benefit">Potongan <%= t.discountPercent %>% di setiap pembelian produk</div>

          <% if (currentTier.key === t.key) { %>
            <button class="btn small solid mt-16" type="button" disabled style="width:100%;">Member Aktif</button>
          <% } else if (currentTier.order > t.order) { %>
            <button class="btn small ghost mt-16" type="button" disabled style="width:100%;">Sudah Terlewati</button>
          <% } else { %>
            <form method="POST" action="/membership/upgrade">
              <input type="hidden" name="tier" value="<%= t.key %>">
              <button class="btn small magenta mt-16" type="submit" style="width:100%;">Upgrade Sekarang</button>
            </form>
          <% } %>
        </div>
      <% }) %>
    </div>

    <%- include('partials/footer') %>
  </div>
</div>
<script>
function copyApiKey() {
  var field = document.getElementById('apiKeyField');
  var btn = document.getElementById('apiKeyCopyBtn');
  if (!field) return;
  field.select();
  field.setSelectionRange(0, 99999);
  var done = function () {
    if (!btn) return;
    var orig = btn.textContent;
    btn.textContent = 'Tersalin!';
    setTimeout(function () { btn.textContent = orig; }, 1500);
  };
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(field.value).then(done).catch(function () { document.execCommand('copy'); done(); });
  } else {
    document.execCommand('copy');
    done();
  }
}
</script>
</body>
</html>
