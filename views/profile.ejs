<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head') %></head>
<body>
<div class="app-shell">
  <%- include('partials/user-sidebar', { active: 'profile' }) %>

  <div class="main no-bottom-nav">
    <div class="topbar"><h2>Profil Saya</h2></div>

    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert success"><%= success %></div><% } %>

    <div class="card avatar-card">
      <div class="avatar-card-preview">
        <% if (user.avatar) { %>
          <img src="<%= user.avatar %>" alt="<%= user.username %>">
        <% } else { %>
          <span class="avatar-initial"><%= (user.username || '?').charAt(0).toUpperCase() %></span>
        <% } %>
      </div>
      <div class="avatar-card-form">
        <h3 style="margin-bottom:2px;">Foto Profil</h3>
        <div class="helper-text" style="margin-top:0;">JPG, PNG, WEBP, atau GIF, maksimal 2MB. Foto ini tampil bulat di pojok kanan atas.</div>
        <form method="POST" action="/profile/avatar" enctype="multipart/form-data" class="avatar-form">
          <input type="file" name="avatarFile" accept="image/jpeg,image/png,image/webp,image/gif" required>
          <button class="btn small solid mt-16" type="submit">Ganti Foto</button>
        </form>
      </div>
    </div>

    <div class="grid grid-3">
      <div class="card stat-card">
        <div class="label">Saldo Aktif</div>
        <div class="value">Rp <%= user.saldo.toLocaleString('id-ID') %></div>
        <div class="flex" style="gap:8px;">
          <a href="/topup" class="btn small solid">+ Top Up</a>
          <a href="/riwayat-saldo" class="btn small ghost">Riwayat Saldo</a>
        </div>
      </div>
      <div class="card stat-card magenta">
        <div class="label">Total Order</div>
        <div class="value"><%= totalOrder %></div>
      </div>
      <div class="card stat-card success">
        <div class="label">Total Pembelanjaan</div>
        <div class="value">Rp <%= totalSpent.toLocaleString('id-ID') %></div>
      </div>
    </div>

    <div class="section-title"><h3>Order Terbaru</h3><div class="line"></div></div>
    <div class="card">
      <% if (recentOrders.length === 0) { %>
        <div class="empty-state">Belum ada order. <a href="/produk" style="color:var(--cyan)">Mulai belanja →</a></div>
      <% } else { %>
      <table>
        <thead><tr><th>ID</th><th>Produk</th><th>Total</th><th>Status</th><th>Tanggal</th></tr></thead>
        <tbody>
          <% recentOrders.forEach(o => { %>
          <tr>
            <td class="mono"><%= o.id %></td>
            <td><%= o.productName %></td>
            <td class="mono">Rp <%= o.total.toLocaleString('id-ID') %></td>
            <td><span class="badge <%= o.status %>"><%= o.status %></span></td>
            <td><%= new Date(o.createdAt).toLocaleString('id-ID') %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>

    <div class="section-title" id="referral"><h3>Referral</h3><div class="line"></div></div>
    <div class="card ref-share-box">
      <div class="ref-code-row">
        <input type="text" class="ref-code" id="refCode" value="<%= referralCode %>" readonly>
        <button type="button" class="ref-copy-btn" onclick="copyKey('refCode', this)">Salin Kode</button>
      </div>
      <div class="ref-link-row">
        <input type="text" class="ref-link-input" id="refLink" value="<%= referralLink %>" readonly>
        <button type="button" class="ref-copy-btn" onclick="copyKey('refLink', this)">Salin Link</button>
      </div>
      <div class="ref-how">
        Bagikan kode atau link di atas. <b>Setiap orang yang daftar pakai kode kamu</b> akan
        otomatis terhubung ke akunmu, dan kamu dapat <b><%= referralCommissionPercent %>% komisi</b>
        dari <b>setiap transaksi sukses</b> yang mereka lakukan — bukan cuma transaksi pertama.
        Komisi langsung masuk ke saldo, otomatis.
      </div>
    </div>

    <% if (!user.referredBy) { %>
    <div class="card mt-16">
      <h3 style="margin-top:0;">Punya Kode Undangan?</h3>
      <div class="helper-text">Kalau kamu diajak pakai kode punya orang lain (mis. lupa isi pas daftar dulu), masukkan di sini. Cuma bisa dipakai <b>1x</b> dan gak bisa diganti lagi setelah tersimpan.</div>
      <form method="POST" action="/profile/kode-undangan" class="flex" style="gap:8px; margin-top:12px; flex-wrap:wrap;">
        <input type="text" name="referralCode" placeholder="Contoh: AB23CD" maxlength="6" style="text-transform:uppercase; flex:1; min-width:160px;" required>
        <button type="submit" class="btn small solid">Pakai Kode</button>
      </form>
    </div>
    <% } else { %>
    <div class="card mt-16">
      <h3 style="margin-top:0;">Kode Undangan</h3>
      <div class="helper-text">Akun ini sudah terhubung ke kode undangan.</div>
    </div>
    <% } %>

    <div class="grid grid-2">
      <div class="card stat-card success">
        <div class="label">Total Komisi Didapat</div>
        <div class="value">Rp <%= referralStats.totalEarned.toLocaleString('id-ID') %></div>
      </div>
      <div class="card stat-card">
        <div class="label">Orang Terundang</div>
        <div class="value"><%= referralStats.referredCount %></div>
      </div>
    </div>

    <% if (referralStats.history.length > 0) { %>
    <div class="card">
      <table>
        <thead><tr><th>Tanggal</th><th>Dari</th><th>Total Transaksi</th><th>Komisi</th></tr></thead>
        <tbody>
          <% referralStats.history.slice(0, 10).forEach(h => { %>
          <tr>
            <td style="white-space:nowrap;"><%= new Date(h.createdAt).toLocaleString('id-ID') %></td>
            <td><%= h.buyerUsername %></td>
            <td class="mono">Rp <%= h.orderTotal.toLocaleString('id-ID') %></td>
            <td class="mono" style="color:var(--success); font-weight:700;">+ Rp <%= h.commission.toLocaleString('id-ID') %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>

    <div class="section-title"><h3>Akun</h3><div class="line"></div></div>
    <div class="grid grid-2">
      <div class="card">
        <h3>Informasi Akun</h3>
        <form method="POST" action="/profile">
          <label>Username</label>
          <input type="text" value="<%= user.username %>" disabled>
          <label>Email</label>
          <input type="email" name="email" required value="<%= user.email || '' %>">
          <div style="font-size:11px; color:var(--text-dim); margin:-6px 0 12px;">Dipakai buat login & reset password, pastikan aktif.</div>
          <label>Saldo</label>
          <input type="text" value="Rp <%= user.saldo.toLocaleString('id-ID') %>" disabled class="mono">
          <label>Status Member</label>
          <input type="text" value="<%= currentTier.icon %> <%= currentTier.label %>" disabled>
          <button class="btn solid mt-24" type="submit">Simpan Perubahan</button>
        </form>
      </div>

      <div class="card">
        <h3><%= user.password ? 'Ganti Password' : 'Buat Password' %></h3>
        <% if (!user.password) { %>
          <div class="helper-text" style="margin-top:0;">Akun kamu terdaftar lewat Google dan belum punya password lokal. Buat password di sini kalau mau juga bisa masuk pakai username &amp; password (opsional).</div>
        <% } %>
        <form method="POST" action="/profile/password">
          <% if (user.password) { %>
          <label>Password Lama</label>
          <input type="password" name="oldPassword" required>
          <% } %>
          <label>Password Baru</label>
          <input type="password" name="newPassword" required minlength="6">
          <label>Konfirmasi Password Baru</label>
          <input type="password" name="newPassword2" required minlength="6">
          <button class="btn magenta mt-24" type="submit"><%= user.password ? 'Update Password' : 'Buat Password' %></button>
        </form>
      </div>
    </div>

    <div class="section-title"><h3>Login Google</h3><div class="line"></div></div>
    <% const googleReady = !!(config.google && config.google.enabled && config.google.clientId && config.google.clientSecret); %>
    <div class="card">
      <div class="connected-account-row">
        <div class="connected-account-info">
          <i class="fa-brands fa-google"></i>
          <div>
            <div style="font-weight:600;"><%= user.googleId ? 'Akun Google terhubung' : 'Akun Google belum terhubung' %></div>
            <div class="helper-text" style="margin:2px 0 0;"><% if (user.googleId) { %>Kamu bisa masuk pakai tombol "Masuk dengan Google" di halaman login.<% } else if (googleReady) { %>Hubungkan supaya bisa masuk tanpa ketik username &amp; password.<% } else { %>Login Google belum diaktifkan oleh admin.<% } %></div>
          </div>
        </div>
        <% if (user.googleId) { %>
          <form method="POST" action="/profile/google/disconnect" onsubmit="return confirm('Putuskan akun Google dari profil ini? Kamu tetap bisa masuk pakai username &amp; password.');" style="margin:0;">
            <button class="btn small ghost" type="submit">Putuskan</button>
          </form>
        <% } else if (googleReady) { %>
          <a href="/auth/google" class="btn small solid">Hubungkan Google</a>
        <% } %>
      </div>
    </div>

    <div class="section-title"><h3>API Reseller</h3><div class="line"></div></div>
    <div class="card">
      <div class="helper-text">
        Transaksi otomatis lewat API untuk integrasi bot/website kamu sendiri. Semua harga produk lewat API ini otomatis dihitung pakai harga <b>tier Platinum</b>, berapapun membership akun kamu sebenarnya. API key transaksi &amp; deposit <b>sengaja dipisah</b> (2 key independen) supaya kalau salah satu bocor, yang lain tetap aman. Tiap key WAJIB didaftarkan ke 1 alamat <b>IP (IPv4 atau IPv6)</b> -- request cuma diterima dari IP itu. Dibatasi <b>60 request/menit</b> per key.
      </div>
    </div>

    <!-- API Key TRANSAKSI -->
    <div class="card">
      <label style="font-size:14px; font-weight:700; display:block; margin-bottom:10px;"><i class="fa-solid fa-bolt"></i> API Key Transaksi</label>
      <div class="helper-text" style="margin-bottom:12px;">Buat cek harga, cek saldo, dan bikin order (topup/SMM/manual/OTP). <b>Tidak bisa</b> dipakai untuk endpoint deposit.</div>
      <% if (user.apiKeyTransaction) { %>
        <div class="flex" style="gap:8px; align-items:center; flex-wrap:wrap;">
          <input type="text" id="apiKeyTransactionField" value="<%= user.apiKeyTransaction %>" readonly style="flex:1; min-width:220px; font-family:monospace; font-size:13px;">
          <button type="button" class="btn small ghost" onclick="copyKey('apiKeyTransactionField', this)">Salin</button>
        </div>
        <div class="helper-text" style="margin:8px 0;">Terdaftar untuk IP: <code><%= user.apiKeyTransactionIp || '-' %></code></div>
        <form method="POST" action="/profile/api-key/generate" onsubmit="return confirm('Generate ulang API Key Transaksi? Key lama langsung berhenti berfungsi.')" style="margin:0 0 10px;">
          <input type="hidden" name="scope" value="transaction">
          <label style="font-size:12px;">IP baru (IPv4/IPv6, kosongkan buat pakai yang sama: <%= user.apiKeyTransactionIp || '-' %>)</label>
          <div class="flex" style="gap:8px; margin-top:4px;">
            <input type="text" name="ipv6" placeholder="mis. 103.10.20.30 atau 2001:db8::1" style="flex:1;">
            <button class="btn small ghost" type="submit">Generate Ulang</button>
          </div>
        </form>
        <form method="POST" action="/profile/api-key/revoke" onsubmit="return confirm('Cabut API Key Transaksi? Semua integrasi yang pakai key ini langsung berhenti bisa akses.')" style="margin:0;">
          <input type="hidden" name="scope" value="transaction">
          <button class="btn small danger" type="submit">Cabut Key Transaksi</button>
        </form>
      <% } else { %>
        <form method="POST" action="/profile/api-key/generate" style="margin:0;">
          <input type="hidden" name="scope" value="transaction">
          <label style="font-size:12px;">Alamat IP -- IPv4 atau IPv6 (wajib -- request API cuma diterima dari IP ini)</label>
          <div class="flex" style="gap:8px; margin-top:4px;">
            <input type="text" name="ipv6" placeholder="mis. 103.10.20.30 atau 2001:db8::1" required style="flex:1;">
            <button class="btn small solid" type="submit">Generate Key Transaksi</button>
          </div>
        </form>
      <% } %>
    </div>

    <!-- API Key DEPOSIT -->
    <div class="card">
      <label style="font-size:14px; font-weight:700; display:block; margin-bottom:10px;"><i class="fa-solid fa-money-bill-transfer"></i> API Key Deposit</label>
      <div class="helper-text" style="margin-bottom:12px;">Khusus buat bikin &amp; cek transaksi deposit/top up saldo lewat API. <b>Tidak bisa</b> dipakai untuk cek harga atau bikin order.</div>
      <% if (user.apiKeyDeposit) { %>
        <div class="flex" style="gap:8px; align-items:center; flex-wrap:wrap;">
          <input type="text" id="apiKeyDepositField" value="<%= user.apiKeyDeposit %>" readonly style="flex:1; min-width:220px; font-family:monospace; font-size:13px;">
          <button type="button" class="btn small ghost" onclick="copyKey('apiKeyDepositField', this)">Salin</button>
        </div>
        <div class="helper-text" style="margin:8px 0;">Terdaftar untuk IP: <code><%= user.apiKeyDepositIp || '-' %></code></div>
        <form method="POST" action="/profile/api-key/generate" onsubmit="return confirm('Generate ulang API Key Deposit? Key lama langsung berhenti berfungsi.')" style="margin:0 0 10px;">
          <input type="hidden" name="scope" value="deposit">
          <label style="font-size:12px;">IP baru (IPv4/IPv6, kosongkan buat pakai yang sama: <%= user.apiKeyDepositIp || '-' %>)</label>
          <div class="flex" style="gap:8px; margin-top:4px;">
            <input type="text" name="ipv6" placeholder="mis. 103.10.20.30 atau 2001:db8::1" style="flex:1;">
            <button class="btn small ghost" type="submit">Generate Ulang</button>
          </div>
        </form>
        <form method="POST" action="/profile/api-key/revoke" onsubmit="return confirm('Cabut API Key Deposit? Semua integrasi yang pakai key ini langsung berhenti bisa akses.')" style="margin:0;">
          <input type="hidden" name="scope" value="deposit">
          <button class="btn small danger" type="submit">Cabut Key Deposit</button>
        </form>
      <% } else { %>
        <form method="POST" action="/profile/api-key/generate" style="margin:0;">
          <input type="hidden" name="scope" value="deposit">
          <label style="font-size:12px;">Alamat IP -- IPv4 atau IPv6 (wajib -- request API cuma diterima dari IP ini)</label>
          <div class="flex" style="gap:8px; margin-top:4px;">
            <input type="text" name="ipv6" placeholder="mis. 103.10.20.30 atau 2001:db8::1" required style="flex:1;">
            <button class="btn small solid" type="submit">Generate Key Deposit</button>
          </div>
        </form>
      <% } %>
    </div>

    <% if (user.apiKeyTransaction || user.apiKeyDeposit) { %>
    <div class="card">
      <label style="font-size:13px; font-weight:600; display:block; margin-bottom:6px;">Contoh Pemakaian</label>
      <div class="helper-text" style="margin-bottom:6px;">Base URL: <code><%= apiBaseUrl %></code> &middot; kirim key lewat header <code>X-API-Key</code></div>
      <% if (user.apiKeyTransaction) { %>
      <pre class="doc-code">curl <%= apiBaseUrl %>/pricelist \
  -H "X-API-Key: <%= user.apiKeyTransaction %>"

# Order dipisah per jenis produk: /order/topup, /order/smm, /order/manual, /order/otp
curl -X POST <%= apiBaseUrl %>/order/topup \
  -H "X-API-Key: <%= user.apiKeyTransaction %>" \
  -H "Content-Type: application/json" \
  -d '{"product_id":"ID_PRODUK","qty":1,"target":{"user_id":"12345"},"ref_id":"order-saya-001"}'</pre>
      <% } %>
      <% if (user.apiKeyDeposit) { %>
      <pre class="doc-code">curl -X POST <%= apiBaseUrl %>/deposit \
  -H "X-API-Key: <%= user.apiKeyDeposit %>" \
  -H "Content-Type: application/json" \
  -d '{"amount":50000}'</pre>
      <% } %>
      <p style="margin:10px 0 0;"><a href="/dokumentasi-api" style="color:var(--cyan);"><i class="fa-solid fa-book"></i> Lihat dokumentasi API lengkap</a> (semua endpoint: produk, transaksi, deposit, cek saldo)</p>
    </div>
    <% } %>

    <div class="section-title"><h3>Membership</h3><div class="line"></div></div>
    <div class="grid grid-3">
      <% membershipList.filter(t => t.key !== 'reguler').forEach(t => { %>
        <div class="card member-card member-<%= t.key %>">
          <div class="member-card-icon"><%= t.icon %></div>
          <div class="member-card-title"><%= t.label %></div>
          <div class="member-card-price">Rp <%= t.price.toLocaleString('id-ID') %></div>
          <div class="member-card-benefit">Potongan <%= t.discountPercent %>% di setiap pembelian produk</div>

          <% if (currentTier.key === t.key) { %>
            <button class="btn small solid mt-16" type="button" disabled style="width:100%;">Member Aktif</button>
          <% } else if (currentTier.order > t.order) { %>
            <button class="btn small ghost mt-16" type="button" disabled style="width:100%;">Sudah Terlewati</button>
          <% } else { %>
            <form method="POST" action="/membership/upgrade">
              <input type="hidden" name="tier" value="<%= t.key %>">
              <button class="btn small magenta mt-16" type="submit" style="width:100%;">Upgrade Sekarang</button>
            </form>
          <% } %>
        </div>
      <% }) %>
    </div>

    <%- include('partials/footer') %>
  </div>
</div>
<script>
function copyKey(fieldId, btn) {
  var field = document.getElementById(fieldId);
  if (!field) return;
  field.select();
  field.setSelectionRange(0, 99999);
  var done = function () {
    if (!btn) return;
    var orig = btn.textContent;
    btn.textContent = 'Tersalin!';
    setTimeout(function () { btn.textContent = orig; }, 1500);
  };
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(field.value).then(done).catch(function () { document.execCommand('copy'); done(); });
  } else {
    document.execCommand('copy');
    done();
  }
}

// Tombol "Salin" otomatis buat blok contoh kode API (.doc-code) -- pola sama kayak di
// /dokumentasi-api, dipisah di sini karena halaman ini gak nge-include script itu.
(function () {
  function fallbackCopy(pre) {
    var range = document.createRange();
    range.selectNodeContents(pre);
    var sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
    document.execCommand('copy');
    sel.removeAllRanges();
  }
  document.querySelectorAll('.doc-code').forEach(function (pre) {
    var wrap = document.createElement('div');
    wrap.className = 'doc-code-wrap';
    pre.parentNode.insertBefore(wrap, pre);
    wrap.appendChild(pre);

    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'doc-copy-btn';
    btn.title = 'Salin';
    btn.innerHTML = '<i class="fa-solid fa-copy"></i>';
    wrap.appendChild(btn);

    btn.addEventListener('click', function () {
      var text = pre.textContent;
      function done() {
        btn.innerHTML = '<i class="fa-solid fa-check"></i>';
        setTimeout(function () { btn.innerHTML = '<i class="fa-solid fa-copy"></i>'; }, 1200);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done).catch(function () { fallbackCopy(pre); done(); });
      } else {
        fallbackCopy(pre);
        done();
      }
    });
  });
})();
</script>
</body>
</html>
