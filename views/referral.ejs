<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head') %>
<style>
.ref-share-box {
  background: var(--bg-panel);
  border: 1.5px solid var(--border-glow);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
}
.ref-code-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}
.ref-code {
  font-family: var(--font-display);
  font-size: 26px;
  letter-spacing: 4px;
  color: var(--cyan);
  background: var(--bg-panel-2);
  border: 1.5px dashed var(--border-glow);
  border-radius: 10px;
  padding: 10px 16px;
  flex: 1;
  text-align: center;
}
.ref-link-row { display: flex; gap: 8px; }
.ref-link-input {
  flex: 1;
  min-width: 0;
  padding: 10px 12px;
  border: 1.5px solid var(--border-glow);
  border-radius: 9px;
  background: var(--bg-panel-2);
  color: var(--text-dim);
  font-size: 12px;
}
.ref-copy-btn {
  flex: none;
  padding: 0 16px;
  border: none;
  border-radius: 9px;
  background: var(--cyan);
  color: #fff;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
}
.ref-copy-btn:active { transform: scale(.97); }
.ref-how { font-size: 12px; color: var(--text-dim); line-height: 1.6; margin-top: 12px; }
.ref-how b { color: var(--text-main); }
.ref-empty-hint { font-size: 11px; color: var(--text-dim); margin-top: -6px; margin-bottom: 12px; }
</style>
</head>
<body>
<div class="app-shell">
  <%- include('partials/user-sidebar', { active: 'referral', user, config }) %>

  <div class="main no-bottom-nav">
    <div class="topbar">
      <h2>Referral</h2>
      <div class="user-chip"><span class="dot"></span> Saldo: Rp <%= user.saldo.toLocaleString('id-ID') %></div>
    </div>

    <div class="ref-share-box">
      <div class="ref-code-row">
        <div class="ref-code" id="refCode"><%= referralCode %></div>
        <button type="button" class="ref-copy-btn" id="copyCodeBtn">Salin Kode</button>
      </div>
      <div class="ref-link-row">
        <input type="text" class="ref-link-input" id="refLink" value="<%= referralLink %>" readonly>
        <button type="button" class="ref-copy-btn" id="copyLinkBtn">Salin Link</button>
      </div>
      <div class="ref-how">
        Bagikan kode atau link di atas. <b>Setiap orang yang daftar pakai kode kamu</b> akan
        otomatis terhubung ke akunmu, dan kamu dapat <b><%= commissionPercent %>% komisi</b> dari
        <b>setiap transaksi sukses</b> yang mereka lakukan — bukan cuma transaksi pertama.
        Komisi langsung masuk ke saldo, otomatis.
      </div>
    </div>

    <div class="grid grid-2">
      <div class="card stat-card success">
        <div class="label">Total Komisi Didapat</div>
        <div class="value">Rp <%= stats.totalEarned.toLocaleString('id-ID') %></div>
      </div>
      <div class="card stat-card">
        <div class="label">Orang Terundang</div>
        <div class="value"><%= stats.referredCount %></div>
      </div>
    </div>

    <div class="section-title"><h3>Riwayat Komisi</h3><div class="line"></div></div>
    <div class="card">
      <% if (stats.history.length === 0) { %>
        <div class="empty-state">Belum ada komisi masuk. Yuk bagikan kode referral kamu ke teman!</div>
      <% } else { %>
      <table>
        <thead><tr><th>Tanggal</th><th>Dari</th><th>Total Transaksi</th><th>Komisi</th></tr></thead>
        <tbody>
          <% stats.history.forEach(h => { %>
          <tr>
            <td style="white-space:nowrap;"><%= new Date(h.createdAt).toLocaleString('id-ID') %></td>
            <td><%= h.buyerUsername %></td>
            <td class="mono">Rp <%= h.orderTotal.toLocaleString('id-ID') %></td>
            <td class="mono" style="color:var(--success); font-weight:700;">+ Rp <%= h.commission.toLocaleString('id-ID') %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>

    <%- include('partials/footer') %>
  </div>
</div>

<script>
  function copyText(text, btn) {
    var originalLabel = btn.textContent;
    navigator.clipboard.writeText(text).then(function () {
      btn.textContent = 'Tersalin!';
      setTimeout(function () { btn.textContent = originalLabel; }, 1500);
    }).catch(function () {
      btn.textContent = 'Gagal, coba manual';
      setTimeout(function () { btn.textContent = originalLabel; }, 1500);
    });
  }
  var copyCodeBtn = document.getElementById('copyCodeBtn');
  if (copyCodeBtn) copyCodeBtn.addEventListener('click', function () {
    copyText(document.getElementById('refCode').textContent.trim(), copyCodeBtn);
  });
  var copyLinkBtn = document.getElementById('copyLinkBtn');
  if (copyLinkBtn) copyLinkBtn.addEventListener('click', function () {
    copyText(document.getElementById('refLink').value, copyLinkBtn);
  });
</script>
</body>
</html>
