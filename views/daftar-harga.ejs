<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head') %></head>
<body>
<div class="app-shell">
  <%- include('partials/user-sidebar', { active: 'harga', user, config }) %>

  <div class="main no-bottom-nav">

    <div class="topbar" style="margin-bottom: 12px;">
      <h2 style="margin:0; font-size:20px;"><i class="fa-solid fa-tags"></i> Daftar Harga Layanan</h2>
    </div>

    <div class="card price-hero-card">
      <div class="stat-card">
        <div class="label">Produk Aktif</div>
        <div class="value"><%= totalProducts %></div>
      </div>
      <div style="font-size:12px; color:var(--text-dim); max-width:320px; text-align:right;">
        Semua harga di bawah ini <b style="color:var(--text-main);">transparan &amp; berlaku untuk semua orang</b>,
        tidak perlu login untuk melihatnya.
        <% if (memberDiscount > 0) { %>
          Harga yang ditampilkan sudah termasuk potongan member <b style="color:var(--cyan);"><%= memberDiscount %>%</b> punyamu.
        <% } else if (!user) { %>
          <a href="/register" style="color:var(--cyan);">Daftar akun</a> untuk kesempatan dapat diskon member.
        <% } %>
      </div>
    </div>

    <!-- ====== SEARCH (filter cepat lintas kategori) ====== -->
    <div class="catalog-search-bar">
      <input type="text" id="hargaSearchInput" placeholder="Cari nama produk atau layanan...">
      <button type="button" class="catalog-search-btn" id="hargaSearchBtn" aria-label="Cari produk"><i class="fa-solid fa-magnifying-glass"></i></button>
    </div>
    <div id="hargaSearchEmpty" class="card empty-state" style="display:none;">Produk "<span id="hargaSearchEmptyTerm"></span>" tidak ditemukan.</div>

    <% if (groups.length > 1) { %>
    <div class="acc-toolbar">
      <button type="button" id="accExpandAll">Buka Semua</button>
      <span style="color:var(--border-glow);">|</span>
      <button type="button" id="accCollapseAll">Tutup Semua</button>
    </div>
    <div class="price-list-jump">
      <% groups.forEach(g => { %>
        <a href="#cat-<%= g.category.replace(/[^a-zA-Z0-9]/g,'-') %>" class="acc-jump-link" data-jump-target="cat-<%= g.category.replace(/[^a-zA-Z0-9]/g,'-') %>"><%= g.category %></a>
      <% }) %>
    </div>
    <% } %>

    <% if (groups.length === 0) { %>
      <div class="card empty-state">Belum ada produk tersedia saat ini.</div>
    <% } else { %>
      <% groups.forEach((g, idx) => { %>
        <% const catLower = g.category.toLowerCase();
           const catIcon = catLower.indexOf('otp') !== -1 ? 'fa-shield-halved'
             : (catLower.indexOf('sosmed') !== -1 || catLower.indexOf('smm') !== -1) ? 'fa-share-nodes'
             : 'fa-gamepad';
           const sectionId = 'cat-' + g.category.replace(/[^a-zA-Z0-9]/g, '-');
        %>
        <div class="acc-section price-list-group<%= idx === 0 ? ' open' : '' %>" data-price-group data-category="<%= g.category %>" id="<%= sectionId %>">
          <button type="button" class="acc-header" aria-expanded="<%= idx === 0 ? 'true' : 'false' %>">
            <span class="acc-header-title"><i class="fa-solid <%= catIcon %> acc-icon"></i> <%= g.category %> <span class="acc-count"><%= g.products.length %> produk</span></span>
            <i class="fa-solid fa-chevron-down acc-chevron"></i>
          </button>
          <div class="acc-body">
            <div class="price-row-list">
              <% g.products.forEach(p => { %>
                <a href="<%= p.priceListHref %>" class="price-row" data-name="<%= p.name.toLowerCase() %>">
                  <div class="price-row-info">
                    <div class="price-row-name"><%= p.name %></div>
                    <% const isAuto = p.provider === 'digiflazz'; const stockCount = p.stockItems ? p.stockItems.length : 0; %>
                    <div class="price-row-meta">
                      <%= p.provider === 'otp' ? (p.otpServiceName + ' - ' + p.otpCountryName)
                        : p.provider === 'indosmm' ? 'Diproses otomatis, min ' + (p.indosmmMin || 1) + ' / maks ' + (p.indosmmMax || '-')
                        : isAuto ? 'Pengiriman instan otomatis'
                        : (stockCount > 0 ? stockCount + ' stok tersedia' : 'Stok manual diproses admin') %>
                    </div>
                  </div>
                  <div class="price-row-price-wrap">
                    <% if (p.finalPrice < p.price) { %><span class="price-row-price-old">Rp <%= p.price.toLocaleString('id-ID') %></span><% } %>
                    <span class="price-row-price">Rp <%= p.finalPrice.toLocaleString('id-ID') %><%= p.priceListUnit %></span>
                  </div>
                </a>
              <% }) %>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>

    <%- include('partials/footer') %>
  </div>
</div>

<script>
(function () {
  var sections = document.querySelectorAll('.acc-section');

  function setOpen(section, open) {
    section.classList.toggle('open', open);
    var header = section.querySelector('.acc-header');
    if (header) header.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  // Klik header -> buka/tutup section itu sendiri
  sections.forEach(function (section) {
    var header = section.querySelector('.acc-header');
    if (header) header.addEventListener('click', function () { setOpen(section, !section.classList.contains('open')); });
  });

  var expandAllBtn = document.getElementById('accExpandAll');
  var collapseAllBtn = document.getElementById('accCollapseAll');
  if (expandAllBtn) expandAllBtn.addEventListener('click', function () { sections.forEach(function (s) { setOpen(s, true); }); });
  if (collapseAllBtn) collapseAllBtn.addEventListener('click', function () { sections.forEach(function (s) { setOpen(s, false); }); });

  // Klik link "loncat ke kategori" -> pastikan section itu terbuka sebelum browser scroll ke sana
  document.querySelectorAll('.acc-jump-link').forEach(function (link) {
    link.addEventListener('click', function () {
      var target = document.getElementById(link.dataset.jumpTarget);
      if (target) setOpen(target, true);
    });
  });

  // Kalau halaman dibuka langsung dengan #cat-... di URL (link dibagikan), buka section-nya
  if (location.hash) {
    var target = document.querySelector(location.hash);
    if (target && target.classList.contains('acc-section')) setOpen(target, true);
  }

  // ====== PENCARIAN ======
  var input = document.getElementById('hargaSearchInput');
  if (!input) return;
  var searchBtn = document.getElementById('hargaSearchBtn');
  if (searchBtn) searchBtn.addEventListener('click', function () { input.focus(); });
  var groups = document.querySelectorAll('[data-price-group]');
  var emptyBox = document.getElementById('hargaSearchEmpty');
  var emptyTerm = document.getElementById('hargaSearchEmptyTerm');

  input.addEventListener('input', function () {
    var q = input.value.trim().toLowerCase();
    var totalVisible = 0;

    groups.forEach(function (group) {
      var rows = group.querySelectorAll('.price-row');
      var visibleInGroup = 0;
      rows.forEach(function (row) {
        var match = !q || (row.dataset.name || '').includes(q);
        row.style.display = match ? '' : 'none';
        if (match) { visibleInGroup++; totalVisible++; }
      });
      group.style.display = visibleInGroup > 0 ? '' : 'none';
      // Sedang mencari -> buka otomatis tiap kategori yang ada hasilnya biar kelihatan tanpa diklik
      if (q) setOpen(group, visibleInGroup > 0);
    });

    if (emptyBox) {
      emptyBox.style.display = (q && totalVisible === 0) ? '' : 'none';
      if (emptyTerm) emptyTerm.textContent = input.value.trim();
    }
  });
})();
</script>
</body>
</html>
