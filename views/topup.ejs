<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head') %></head>
<body>
<div class="app-shell">
  <%- include('partials/user-sidebar', { active: 'topup' }) %>

  <div class="main no-bottom-nav">
    <div class="topbar">
      <h2>Top Up Saldo</h2>
      <div class="user-chip"><span class="dot"></span> Saldo: Rp <%= user.saldo.toLocaleString('id-ID') %></div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %><div class="alert success"><%= success %></div><% } %>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>

    <div class="grid grid-2">
      <div class="card" id="form-card">
        <h3>Isi Saldo via QRIS</h3>
        <p class="helper-text">Masukkan nominal top up. QR dinamis akan otomatis dibuat sesuai nominal + fee + kode unik.</p>
        <label>Nominal Top Up (Rp)</label>
        <input type="number" id="amount" min="<%= (config.qris && config.qris.depositMin) || 1000 %>" placeholder="Contoh: 50000">
        <button class="btn solid mt-24" id="btn-create" style="width:100%;">Generate QRIS</button>
        <div id="form-error" class="alert error" style="display:none; margin-top:14px;"></div>
      </div>

      <div class="card" id="qr-card" style="display:none;">
        <h3>Scan QRIS di Bawah</h3>
        <div class="qr-box">
          <img id="qr-image" src="" alt="QR Deposit">
          <button type="button" class="btn small ghost" id="btn-download-qr" style="margin-top:8px;"><i class="fa-solid fa-download"></i> Download QR</button>
          <div class="qr-timer" id="qr-timer">10:00</div>
          <div class="qr-status" id="qr-status">Menunggu pembayaran...</div>
        </div>
        <table style="margin-top:10px;">
          <tr><td>Nominal Topup</td><td class="mono" id="d-amount"></td></tr>
          <tr><td>Total Bayar</td><td class="mono" id="d-total"></td></tr>
          <tr><td>ID Transaksi</td><td class="mono" id="d-trxid"></td></tr>
        </table>
        <button class="btn danger mt-16" id="btn-cancel" style="width:100%;">Batal Transaksi</button>
      </div>
    </div>

    <%
    // Kartu ringkas (ikon + nominal + status/waktu), gaya sama kayak riwayat.ejs & admin/order.ejs
    // biar tampilan riwayat top up ini juga rapi & konsisten -- bukan tabel lebar kayak sebelumnya.
    function tuDuration(startIso, endIso) {
      const ms = new Date(endIso).getTime() - new Date(startIso).getTime();
      if (!isFinite(ms) || ms < 0) return null;
      const totalSec = Math.round(ms / 1000);
      if (totalSec < 60) return totalSec + ' detik';
      const min = Math.floor(totalSec / 60);
      const sec = totalSec % 60;
      return min + ' menit' + (sec > 0 ? ' ' + sec + ' detik' : '');
    }
    function tuStatus(d) {
      if (d.status === 'paid') {
        const dur = tuDuration(d.createdAt, d.paidAt);
        return { cls: 'oc-status-done', icon: 'fa-bolt', label: dur ? `Berhasil dalam ${dur}` : 'Berhasil' };
      }
      if (d.status === 'cancelled') return { cls: 'oc-status-cancel', icon: 'fa-ban', label: 'Dibatalkan' };
      if (d.status === 'expired') return { cls: 'oc-status-cancel', icon: 'fa-hourglass-end', label: 'Kadaluarsa' };
      return { cls: 'oc-status-pending', icon: 'fa-clock', label: 'Menunggu pembayaran' };
    }
    %>
    <div class="section-title"><h3>Riwayat Top Up</h3><div class="line"></div></div>
    <% if (deposits.length === 0) { %>
      <div class="card empty-state">Belum ada riwayat top up.</div>
    <% } else { %>
    <div class="oc-list">
      <% deposits.forEach(d => { const st = tuStatus(d); %>
      <div class="oc-row">
        <div class="oc-row-main">
          <div class="oc-icon <%= d.status === 'paid' ? 'oc-icon-success' : (d.status === 'pending' ? '' : 'oc-icon-danger') %>"><i class="fa-solid fa-qrcode"></i></div>
          <div class="oc-body">
            <div class="oc-id"><%= d.trxid %></div>
            <div class="oc-title"><i class="fa-solid fa-wallet"></i> Top Up Saldo QRIS</div>
            <div class="oc-sub"><i class="fa-solid fa-box"></i> Nominal Rp <%= d.amount.toLocaleString('id-ID') %> &middot; bayar Rp <%= d.total.toLocaleString('id-ID') %></div>
            <div class="oc-status <%= st.cls %>"><i class="fa-solid <%= st.icon %>"></i> <%= st.label %></div>
            <div class="helper-text" style="margin-top:4px;"><%= new Date(d.createdAt).toLocaleString('id-ID') %></div>
            <% if (d.status === 'pending') { %>
            <div class="oc-actions">
              <form method="POST" action="/topup/<%= d.trxid %>/batal" class="js-confirm-submit" data-confirm-title="Batalkan Top Up" data-confirm-msg="Batalkan transaksi top up ini?" data-confirm-danger="true">
                <button class="btn small danger" type="submit"><i class="fa-solid fa-ban"></i> Batal</button>
              </form>
            </div>
            <% } %>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>

    <%- include('partials/footer') %>
  </div>
</div>

<script src="/js/topup.js"></script>
</body>
</html>
