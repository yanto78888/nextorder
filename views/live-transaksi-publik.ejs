<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
</head>
<body>
<div class="app-shell">
  <%- include('partials/user-sidebar', { active: 'live-transaksi', user, config }) %>

  <div class="main no-bottom-nav">
    <div class="topbar">
      <h2><i class="fa-solid fa-tower-broadcast"></i> Live Transaksi</h2>
      <div class="live-indicator" id="liveIndicator"><span class="live-dot"></span> Live</div>
    </div>

    <p class="helper-text" style="margin:0 0 16px;">Transaksi yang lagi berjalan di <%= config.siteName || 'toko ini' %>, diperbarui otomatis. Username & data tujuan disensor sebagian untuk menjaga privasi pembeli.</p>

    <!-- ====== GRAFIK TRANSAKSI (PUBLIK): Harian & Bulanan, transparansi buat pengunjung ====== -->
    <div class="adm-chart-card" id="publicChartCard">
      <div class="adm-chart-header">
        <div class="adm-chart-title"><i class="fa-solid fa-chart-column" style="color:var(--cyan);"></i> Grafik Transaksi</div>
        <div class="adm-chart-tabs">
          <button type="button" class="adm-tab active" data-range="daily">Harian</button>
          <button type="button" class="adm-tab" data-range="monthly">Bulanan</button>
        </div>
      </div>
      <div class="adm-chart-summary">
        <span class="pill-badge cyan"><i class="fa-solid fa-cart-shopping"></i> <span id="publicChartOrdersTotal">0</span> transaksi</span>
        <span class="pill-badge green"><i class="fa-solid fa-sack-dollar"></i> Rp <span id="publicChartOmzetTotal">0</span></span>
      </div>
      <div class="adm-chart-wrap">
        <canvas id="publicSalesChart"></canvas>
      </div>
      <div class="helper-text" style="margin-top:10px; margin-bottom:0;">
        <i class="fa-solid fa-circle-info"></i> Data agregat jumlah transaksi & total nilai transaksi (order yang tidak dibatalkan) di <%= config.siteName || 'toko ini' %> -- ditampilkan buat transparansi, bukan detail per transaksi.
      </div>
    </div>

    <div class="card">
      <div class="flex" style="gap:10px; flex-wrap:wrap; align-items:center;">
        <input type="text" id="liveSearch" placeholder="Cari ID order / nama produk..." style="flex:1; min-width:220px;">
        <span class="helper-text" id="liveCount"><%= orders.length %> transaksi</span>
      </div>
    </div>

    <div class="card" style="padding:0; overflow:hidden;">
      <div style="overflow-x:auto;">
      <table id="liveTable" style="margin:0;">
        <thead><tr><th>Waktu</th><th>Order ID</th><th>User</th><th>Produk</th><th>Qty</th><th>Total</th><th>Status</th><th>Tujuan</th></tr></thead>
        <tbody id="liveTableBody">
          <%- include('partials/live-transaksi-publik-rows', { orders }) %>
        </tbody>
      </table>
      </div>
      <div class="empty-state" id="liveEmpty" style="<%= orders.length > 0 ? 'display:none;' : '' %>">Belum ada transaksi.</div>
    </div>

    <div class="section-title"><h3>FAQ</h3><div class="line"></div></div>
    <div class="card">
      <details class="doc-faq">
        <summary>Kenapa username & tujuannya disensor?</summary>
        <p>Supaya privasi setiap pembeli tetap terjaga. Kamu tetap bisa lihat aktivitas transaksi berjalan secara real-time tanpa mengorbankan data pribadi orang lain.</p>
      </details>
      <details class="doc-faq">
        <summary>Order saya kok gak muncul di sini?</summary>
        <p>Order yang dibatalkan/gagal tidak ditampilkan di feed ini. Kalau order kamu berhasil tapi belum kelihatan, coba refresh -- data diperbarui tiap beberapa detik.</p>
      </details>
      <details class="doc-faq">
        <summary>Bagaimana cara cek detail order saya sendiri?</summary>
        <p>Buka <a href="/riwayat-order" style="color:var(--cyan);">Riwayat Order</a> di akunmu (perlu login) untuk lihat detail lengkap tanpa sensor.</p>
      </details>
    </div>

    <%- include('partials/footer') %>
  </div>
</div>
<script>
(function () {
  var searchInput = document.getElementById('liveSearch');
  var tbody = document.getElementById('liveTableBody');
  var emptyBox = document.getElementById('liveEmpty');
  var countEl = document.getElementById('liveCount');
  var indicator = document.getElementById('liveIndicator');
  var searchDebounce = null;

  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function fmtRupiah(n) { return 'Rp ' + Number(n || 0).toLocaleString('id-ID'); }
  function statusBadgeClass(s) { return s === 'completed' ? 'completed' : (s === 'cancelled' ? 'cancelled' : 'admin'); }
  function statusLabel(s) { return s === 'completed' ? 'Selesai' : (s === 'cancelled' ? 'Dibatalkan' : 'Diproses'); }

  function render(orders) {
    if (orders.length === 0) {
      tbody.innerHTML = '';
      emptyBox.style.display = '';
    } else {
      emptyBox.style.display = 'none';
      var html = '';
      orders.forEach(function (o) {
        html += '<tr>' +
          '<td>' + new Date(o.createdAt).toLocaleString('id-ID') + '</td>' +
          '<td class="mono">' + escapeHtml(o.id) + '</td>' +
          '<td>' + escapeHtml(o.username) + '</td>' +
          '<td>' + escapeHtml(o.productName) + '</td>' +
          '<td>' + o.qty + '</td>' +
          '<td>' + fmtRupiah(o.total) + '</td>' +
          '<td><span class="badge ' + statusBadgeClass(o.status) + '">' + statusLabel(o.status) + '</span></td>' +
          '<td>' + escapeHtml(o.target || '-') + '</td>' +
          '</tr>';
      });
      tbody.innerHTML = html;
    }
    countEl.textContent = orders.length + ' transaksi';
  }

  function fetchData() {
    indicator.classList.add('syncing');
    fetch('/live-transaksi/data')
      .then(function (r) { return r.json(); })
      .then(function (res) {
        if (res && res.success) {
          window.__liveOrders = res.data;
          applySearch();
        }
        indicator.classList.remove('syncing');
      })
      .catch(function () { indicator.classList.remove('syncing'); });
  }

  function applySearch() {
    var q = searchInput.value.trim().toLowerCase();
    var all = window.__liveOrders || [];
    var filtered = !q ? all : all.filter(function (o) {
      return o.id.toLowerCase().indexOf(q) !== -1 || (o.productName || '').toLowerCase().indexOf(q) !== -1;
    });
    render(filtered);
  }

  searchInput.addEventListener('input', function () {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(applySearch, 200);
  });

  setInterval(fetchData, 4000);
  document.addEventListener('visibilitychange', function () {
    if (!document.hidden) fetchData();
  });
})();

// ===== GRAFIK TRANSAKSI PUBLIK (Harian / Bulanan) =====
(function () {
  var canvas = document.getElementById('publicSalesChart');
  if (!canvas || typeof Chart === 'undefined') return;

  var daily = {
    labels: <%- chartDailyLabels %>,
    orders: <%- chartDailyOrders %>,
    total: <%- chartDailyTotal %>
  };
  var monthly = {
    labels: <%- chartMonthlyLabels %>,
    orders: <%- chartMonthlyOrders %>,
    total: <%- chartMonthlyTotal %>
  };

  Chart.defaults.color = '#8c8c8c';
  Chart.defaults.font.family = 'Inter, sans-serif';
  Chart.defaults.font.size = 11;

  var rootStyles = getComputedStyle(document.documentElement);
  var cyan = rootStyles.getPropertyValue('--cyan').trim() || '#1565c0';
  var success = rootStyles.getPropertyValue('--success-light').trim() || '#2fbf71';

  var ctx = canvas.getContext('2d');
  var chart = new Chart(ctx, {
    data: {
      labels: daily.labels,
      datasets: [
        {
          type: 'bar',
          label: 'Transaksi',
          data: daily.orders,
          backgroundColor: cyan + '55',
          borderColor: cyan,
          borderWidth: 1,
          borderRadius: 4,
          yAxisID: 'yOrders',
          order: 2
        },
        {
          type: 'line',
          label: 'Total (Rp)',
          data: daily.total,
          borderColor: success,
          backgroundColor: success,
          tension: 0.35,
          pointRadius: 2,
          yAxisID: 'yTotal',
          order: 1
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { display: true, labels: { boxWidth: 10, usePointStyle: true } },
        tooltip: {
          callbacks: {
            label: function (item) {
              if (item.dataset.yAxisID === 'yTotal') return ' Total: Rp ' + Number(item.raw || 0).toLocaleString('id-ID');
              return ' Transaksi: ' + item.raw;
            }
          }
        }
      },
      scales: {
        yOrders: { beginAtZero: true, position: 'left', grid: { display: false }, ticks: { precision: 0 } },
        yTotal: { beginAtZero: true, position: 'right', grid: { display: false }, ticks: { callback: function (v) { return 'Rp ' + Number(v).toLocaleString('id-ID'); } } },
        x: { grid: { display: false } }
      }
    }
  });

  function sumOf(arr) { return arr.reduce(function (a, b) { return a + (Number(b) || 0); }, 0); }

  function applyRange(range) {
    var d = range === 'monthly' ? monthly : daily;
    chart.data.labels = d.labels;
    chart.data.datasets[0].data = d.orders;
    chart.data.datasets[1].data = d.total;
    chart.update();
    document.getElementById('publicChartOrdersTotal').textContent = sumOf(d.orders).toLocaleString('id-ID');
    document.getElementById('publicChartOmzetTotal').textContent = sumOf(d.total).toLocaleString('id-ID');
  }

  document.querySelectorAll('#publicChartCard .adm-tab').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('#publicChartCard .adm-tab').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      applyRange(btn.dataset.range);
    });
  });

  applyRange('daily');
})();
</script>
</body>
</html>
