<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>
// Terapkan mode malam/terang SEBELUM CSS lain dimuat, biar halaman gak
// "kedip" putih dulu baru gelap saat direfresh dengan mode malam aktif.
// Default situs sekarang MODE MALAM (senada sama referensi tampilan gelap),
// kecuali user pernah eksplisit milih mode terang lewat toggle (tersimpan
// di localStorage sebagai 'light').
(function () {
  try {
    var saved = localStorage.getItem('nx_theme');
    if (saved !== 'light') document.documentElement.setAttribute('data-theme', 'dark');
  } catch (e) {
    document.documentElement.setAttribute('data-theme', 'dark');
  }
})();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<!-- BUG LAMA: --font-display/--font-body di style.css udah nunjuk ke 'Bebas Neue'/'Inter' dari
     awal, tapi gak ada satupun <link> yang beneran nge-load font-nya -- jadi selama ini SELALU
     fallback ke font sistem default browser (nyaris gak ada device yang punya 'Bebas Neue'
     ter-install lokal), bukan cuma di brand doang tapi di SEMUA heading di seluruh situs. -->
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<link rel="stylesheet" href="/css/style.css">
<!-- Notifikasi custom (toast & modal konfirmasi) pengganti alert()/confirm() bawaan browser,
     dimuat global di semua halaman lewat head ini. Lihat public/js/notify.js. -->
<script src="/js/notify.js" defer></script>
<%
  // ---------- Meta SEO & Open Graph ----------
  // Semua halaman otomatis dapat title/description/OG yang masuk akal dari config.siteName +
  // config.seo (diisi di Admin > Setting), TANPA harus di-set manual satu-satu per halaman.
  // Halaman yang mau override cukup kirim local ini pas res.render(...):
  //   pageTitle       - judul spesifik halaman (kalau kosong: "{siteName} - {siteTagline}")
  //   pageDescription - deskripsi spesifik (kalau kosong: config.seo.metaDescription)
  //   pageImage       - path/URL gambar buat og:image (relatif otomatis digabung ke siteOrigin)
  //   noindex         - true buat halaman privat/admin (dashboard, riwayat, panel admin, dst)
  const cfg = typeof config !== 'undefined' && config ? config : {};
  const seo = cfg.seo || {};
  const siteName = cfg.siteName || 'NEXORDER';
  const siteTagline = cfg.siteTagline || '';

  const metaTitle = (typeof pageTitle !== 'undefined' && pageTitle)
    ? pageTitle
    : (siteTagline ? `${siteName} - ${siteTagline}` : siteName);

  const rawDescription = (typeof pageDescription !== 'undefined' && pageDescription)
    ? pageDescription
    : (seo.metaDescription || siteTagline || `Top up game & produk digital di ${siteName}, proses cepat dan aman.`);
  const metaDescription = String(rawDescription).replace(/\s+/g, ' ').trim().slice(0, 160);

  const origin = typeof siteOrigin !== 'undefined' && siteOrigin ? siteOrigin : '';
  const pagePath = typeof currentPath !== 'undefined' && currentPath ? currentPath : '/';
  const canonicalUrl = origin ? origin + pagePath : '';

  const rawImage = (typeof pageImage !== 'undefined' && pageImage) ? pageImage : (seo.ogImage || '');
  const absoluteImage = rawImage
    ? (/^https?:\/\//i.test(rawImage) ? rawImage : origin + (rawImage.startsWith('/') ? rawImage : '/' + rawImage))
    : '';

  const isNoindex = typeof noindex !== 'undefined' && noindex;
%>
<title><%= metaTitle %></title>
<meta name="description" content="<%= metaDescription %>">
<% if (seo.metaKeywords) { %><meta name="keywords" content="<%= seo.metaKeywords %>"><% } %>
<meta name="robots" content="<%= isNoindex ? 'noindex, nofollow' : 'index, follow' %>">
<% if (canonicalUrl) { %><link rel="canonical" href="<%= canonicalUrl %>"><% } %>

<!-- Favicon/logo situs -- muncul di tab browser & di sebelah nama domain pas hasil pencarian
     Google. SEBELUM INI gak ada satupun <link rel="icon"> ataupun file favicon.ico yang
     di-serve, itu sebabnya Google nampilin ikon bulat generik. Fallback ke OG Image kalau
     favicon belum sempat diupload terpisah (Admin > Pengaturan > SEO), lebih baik daripada gak
     ada ikon sama sekali walau rasio gambarnya belum tentu persegi/pas. -->
<% const faviconUrl = seo.favicon || seo.ogImage || ''; %>
<% if (faviconUrl) { %>
<link rel="icon" href="<%= faviconUrl %>">
<link rel="apple-touch-icon" href="<%= faviconUrl %>">
<% } %>

<!-- Open Graph -->
<meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
<meta property="og:site_name" content="<%= siteName %>">
<meta property="og:locale" content="id_ID">
<meta property="og:title" content="<%= metaTitle %>">
<meta property="og:description" content="<%= metaDescription %>">
<% if (canonicalUrl) { %><meta property="og:url" content="<%= canonicalUrl %>"><% } %>
<% if (absoluteImage) { %><meta property="og:image" content="<%= absoluteImage %>">
<meta property="og:image:secure_url" content="<%= absoluteImage %>"><% } %>

<!-- Twitter Card (dibaca juga oleh X/Twitter; WhatsApp & Telegram cukup pakai tag Open Graph di atas) -->
<meta name="twitter:card" content="<%= absoluteImage ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= metaTitle %>">
<meta name="twitter:description" content="<%= metaDescription %>">
<% if (absoluteImage) { %><meta name="twitter:image" content="<%= absoluteImage %>"><% } %>

<!-- JSON-LD Organization -- bantu Google ngaitin logo situs ke domain ini (di luar favicon di
     atas, yang cuma soal ikon kecil di tab/hasil pencarian). Dipasang di semua halaman (bukan
     cuma beranda) -- gak masalah muncul berulang, Google cukup ambil salah satu. Butuh
     canonicalUrl & logo, kalau salah satu belum ke-setting di-skip aja daripada nge-render
     schema yang gak lengkap. -->
<% if (canonicalUrl && faviconUrl) { %>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": siteName,
  "url": origin || canonicalUrl,
  "logo": /^https?:\/\//i.test(faviconUrl) ? faviconUrl : origin + (faviconUrl.startsWith('/') ? faviconUrl : '/' + faviconUrl)
}) %>
</script>
<% } %>
