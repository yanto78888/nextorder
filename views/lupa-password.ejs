<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head') %></head>
<body>
  <div class="auth-split">
    <div class="auth-split-brand">
      <div class="auth-split-brand-inner">
        <div class="auth-split-logo"><i class="fa-solid fa-bolt"></i> <%= config.siteName %></div>
        <div class="auth-split-tagline"><%= config.siteTagline || 'Top Up Game & PPOB Termurah, Proses Otomatis 24 Jam' %></div>
        <ul class="auth-split-features">
          <li><i class="fa-solid fa-shield-halved"></i> Reset password aman lewat email</li>
          <li><i class="fa-solid fa-clock"></i> Kode OTP berlaku 10 menit</li>
          <li><i class="fa-solid fa-headset"></i> Kendala? Tim support siap bantu</li>
        </ul>
      </div>
    </div>

    <div class="auth-split-form-side">
      <div class="auth-card auth-card-split">
        <h1 class="auth-title"><i class="fa-solid fa-key"></i> Lupa Password</h1>
        <div class="auth-sub">Masukkan email akun kamu, kami kirim kode OTP</div>

        <% if (error) { %><div class="alert error"><%= error %></div><% } %>
        <% if (info) { %><div class="alert success"><%= info %></div><% } %>

        <form method="POST" action="/lupa-password">
          <label>Email</label>
          <div class="auth-input-group">
            <i class="fa-solid fa-envelope"></i>
            <input type="email" name="email" required autofocus placeholder="Masukkan email akun kamu">
          </div>
          <button class="btn solid mt-24" type="submit" style="width:100%;"><i class="fa-solid fa-paper-plane"></i> Kirim Kode OTP</button>
        </form>

        <div class="auth-footer">
          Sudah punya kode? <a href="/reset-password">Masukkan kode di sini</a><br>
          <a href="/login">← Kembali ke Login</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
