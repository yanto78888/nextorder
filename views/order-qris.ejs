<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head') %>
<style>
.qris-wrap { max-width: 420px; margin: 0 auto; padding: 20px 16px 100px; }
.qris-card { background: var(--bg-panel); border: 1.5px solid var(--border-glow); border-radius: 16px; padding: 24px 20px; text-align: center; }
.qris-title { font-size: 18px; font-weight: 700; color: var(--text-main); margin-bottom: 4px; }
.qris-sub { font-size: 12px; color: var(--text-dim); margin-bottom: 18px; }
.qris-img { width: 220px; height: 220px; border-radius: 12px; border: 2px solid var(--border-glow); object-fit: contain; background: #fff; margin: 0 auto 10px; display: block; }
.qris-download-btn {
  display: inline-flex; align-items: center; gap: 6px; margin: 0 auto 18px;
  font-size: 12px; font-weight: 700; color: var(--cyan); background: none;
  border: 1px solid var(--border-glow); border-radius: 999px; padding: 7px 14px;
  cursor: pointer; font-family: inherit;
}
.qris-download-btn:hover { border-color: var(--cyan); background: rgba(21,101,192,0.06); }
.qris-amount { font-size: 26px; font-weight: 700; color: var(--cyan); margin-bottom: 4px; }
.qris-note { font-size: 11px; color: var(--text-dim); margin-bottom: 18px; }
.qris-status { padding: 12px; border-radius: 8px; font-size: 13px; font-weight: 600; margin-bottom: 14px; }
.qris-status.pending { background: rgba(245,197,24,0.1); border: 1px solid rgba(245,197,24,0.3); color: #f5c518; }
.qris-status.paid { background: rgba(46,204,113,0.1); border: 1px solid rgba(46,204,113,0.3); color: #2ecc71; }
.qris-status.expired { background: rgba(229,9,20,0.1); border: 1px solid rgba(229,9,20,0.3); color: var(--cyan); }
.qris-timer { font-size: 20px; font-weight: 700; color: var(--magenta); margin-bottom: 6px; }
.qris-product-info { background: var(--bg-panel-2); border-radius: 8px; padding: 12px; margin-bottom: 18px; text-align: left; }
.qris-product-info .pname { font-weight: 700; font-size: 14px; }
.qris-product-info .pqty { font-size: 12px; color: var(--text-dim); margin-top: 2px; }
</style>
</head>
<body>
<div class="app-shell">
  <%- include('partials/user-sidebar', { active: 'produk', user, config }) %>

  <div class="main no-bottom-nav">
    <div class="qris-wrap">
      <div class="qris-card">
        <div class="qris-title">Bayar via QRIS</div>
        <div class="qris-sub">Scan QR di bawah menggunakan m-banking atau e-wallet manapun. Pesanan langsung diproses otomatis begitu QRIS ini terbayar -- tidak lewat saldo.</div>

        <div class="qris-product-info">
          <div class="pname"><%= product.name %></div>
          <div class="pqty">Jumlah: <%= qty %> item</div>
          <% if (typeof targetText !== 'undefined' && targetText) { %>
            <div class="pqty" style="margin-top:6px; color:var(--cyan);"><i class="fa-solid fa-crosshairs"></i> <%= targetText %></div>
          <% } %>
        </div>

        <img class="qris-img" id="qrisImg" src="<%= payment.imageBase64 %>" alt="QRIS">
        <button type="button" class="qris-download-btn" id="btnDownloadQr"><i class="fa-solid fa-download"></i> Download QR</button>

        <div class="qris-amount">Rp <%= payment.total.toLocaleString('id-ID') %></div>
        <div class="qris-note"><i class="fa-solid fa-triangle-exclamation"></i> Bayar tepat nominal di atas (sudah termasuk kode unik & biaya layanan). Jangan lebih, jangan kurang.</div>

        <div class="qris-timer" id="timerEl">--:--</div>

        <div class="qris-status pending" id="statusEl"><i class="fa-solid fa-hourglass-half"></i> Menunggu pembayaran...</div>

        <button type="button" class="btn ghost" id="btnBatal" style="width:100%; margin-top:8px;">Batal / Kembali</button>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var trxid = '<%= payment.trxid %>';
  var productId = '<%= product.id %>';
  var expiredAt = new Date('<%= payment.expiredAt %>').getTime();
  var statusEl = document.getElementById('statusEl');
  var timerEl = document.getElementById('timerEl');
  var settled = false;

  // Download QR sebagai file PNG. BUG: sebelumnya link.href diisi LANGSUNG dari data:image/png;base64
  // (img.src) + atribut download -- di banyak browser mobile (terutama Chrome Android), atribut
  // `download` TIDAK didukung buat data: URI, jadi klik tombolnya cuma buka gambarnya di tab baru,
  // bukan beneran ke-download. Fix: ubah dulu data URI itu jadi Blob (fetch() bisa baca data: URI)
  // lalu pakai Blob URL (createObjectURL) -- dukungan `download` buat blob: URL jauh lebih
  // konsisten lintas browser & HP.
  var downloadBtn = document.getElementById('btnDownloadQr');
  if (downloadBtn) {
    downloadBtn.addEventListener('click', function () {
      var img = document.getElementById('qrisImg');
      if (!img || !img.src) return;
      var filename = 'QRIS-' + trxid + '.png';
      fetch(img.src)
        .then(function (res) { return res.blob(); })
        .then(function (blob) {
          var blobUrl = URL.createObjectURL(blob);
          var link = document.createElement('a');
          link.href = blobUrl;
          link.download = filename;
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          setTimeout(function () { URL.revokeObjectURL(blobUrl); }, 1000);
        })
        .catch(function () {
          // Fallback kalau fetch()-nya somehow gagal -- tetap coba cara lama sebagai upaya terakhir.
          var link = document.createElement('a');
          link.href = img.src;
          link.download = filename;
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        });
    });
  }

  document.getElementById('btnBatal').addEventListener('click', function () {
    if (settled) { window.location.href = '/produk/' + productId; return; }
    showConfirm('Batalkan pembayaran ini?', { title: 'Batalkan Pembayaran', danger: true }).then(function (ok) {
      if (!ok) return;
      fetch('/order/qris-status/' + trxid + '/cancel', { method: 'POST' })
        .catch(function () {})
        .finally(function () { window.location.href = '/produk/' + productId; });
    });
  });

  function updateTimer() {
    var now = Date.now();
    var diff = Math.max(0, expiredAt - now);
    var m = Math.floor(diff / 60000);
    var s = Math.floor((diff % 60000) / 1000);
    if (timerEl) timerEl.textContent = String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
    if (diff <= 0 && !settled) {
      settled = true;
      if (statusEl) { statusEl.innerHTML = '<i class="fa-solid fa-hourglass-end"></i> Waktu habis. Silakan buat pesanan baru.'; statusEl.className = 'qris-status expired'; }
      clearInterval(timerInterval);
      clearInterval(pollInterval);
    }
  }
  updateTimer();
  var timerInterval = setInterval(updateTimer, 1000);

  function pollStatus() {
    fetch('/order/qris-status/' + trxid)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (!data.success) return;
        if (data.status === 'paid') {
          settled = true;
          if (data.redirectUrl) {
            clearInterval(pollInterval);
            clearInterval(timerInterval);
            if (statusEl) { statusEl.innerHTML = '<i class="fa-solid fa-circle-check"></i> Pembayaran diterima! Pesanan sudah dibuat, mengalihkan...'; statusEl.className = 'qris-status paid'; }
            setTimeout(function () { window.location.href = data.redirectUrl; }, 1200);
          } else {
            // Sudah kebayar tapi order-nya masih diproses di background (kejadian sepersekian
            // detik) -- tetap polling sampai redirectUrl-nya kekirim.
            if (statusEl) { statusEl.innerHTML = '<i class="fa-solid fa-circle-check"></i> Pembayaran diterima! Sedang membuat pesanan...'; statusEl.className = 'qris-status paid'; }
          }
        } else if (data.status === 'expired' || data.status === 'cancelled') {
          settled = true;
          clearInterval(pollInterval);
          clearInterval(timerInterval);
          var msg = data.status === 'cancelled' ? 'Pembayaran dibatalkan.' : 'Waktu habis. Silakan buat pesanan baru.';
          if (statusEl) { statusEl.innerHTML = '<i class="fa-solid fa-hourglass-end"></i> ' + msg; statusEl.className = 'qris-status expired'; }
        }
      })
      .catch(function() {});
  }

  // Server-side job cek mutasi QRIS tiap 10 detik (lihat lib/orderQris.js + server.js) -- polling
  // dari browser ke server SENDIRI dibuat lebih cepat dari itu (3 detik) supaya begitu backend
  // ketemu pembayarannya, halaman ini langsung update tanpa nunggu putaran poll berikutnya.
  var pollInterval = setInterval(pollStatus, 3000);
})();
</script>
</body>
</html>
