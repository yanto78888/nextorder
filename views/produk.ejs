<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head') %></head>
<body>
<div class="app-shell">
  <%- include('partials/user-sidebar', { active: 'produk', user, config }) %>

  <div class="main produk-main no-bottom-nav">

    <!-- Topbar info baris atas: badge member + saldo/tamu -->
    <div class="topbar" style="margin-bottom: 12px;">
      <div class="flex" style="gap:8px; margin-left:auto;">
        <% if (user && (user.membership || 'reguler') !== 'reguler') { %>
          <span class="badge member-<%= user.membership %>"><%- user.membership === 'platinum' ? '<i class="fa-solid fa-gem"></i> Platinum' : '<i class="fa-solid fa-medal"></i> Gold' %></span>
        <% } %>
        <% if (user) { %>
          <div class="user-chip"><span class="dot"></span> Rp <%= user.saldo.toLocaleString('id-ID') %></div>
        <% } else { %>
          <a href="/login" class="user-chip guest-chip"><span class="dot guest"></span> Masuk / Daftar</a>
        <% } %>
      </div>
    </div>

    <!-- ====== SKIRK HERO (banner brand ikonik, statis -- beda dari banner-slider promosi di
         bawah yang gambarnya bisa diganti-ganti admin) ====== -->
    <div class="skirk-hero">
      <div class="hs-stars">
        <div class="hs-star" style="top:8%; left:12%;"></div>
        <div class="hs-star" style="top:15%; left:34%; animation-delay:.6s;"></div>
        <div class="hs-star" style="top:6%; left:58%; animation-delay:1.1s;"></div>
        <div class="hs-star" style="top:22%; left:8%; animation-delay:1.7s;"></div>
        <div class="hs-star" style="top:30%; left:44%; animation-delay:.3s;"></div>
        <div class="hs-star" style="top:38%; left:16%; animation-delay:2.1s;"></div>
        <div class="hs-star" style="top:12%; left:80%; animation-delay:1.4s;"></div>
        <div class="hs-star" style="top:26%; left:4%; animation-delay:.9s;"></div>
        <div class="hs-star" style="top:36%; left:64%; animation-delay:2.6s;"></div>
        <div class="hs-star" style="top:5%; left:24%; animation-delay:1.9s;"></div>
      </div>

      <div class="hs-logo-row">
        <svg class="hs-logo-icon" viewBox="0 0 26 26" fill="none">
          <circle cx="13" cy="13" r="12" stroke="#4fd8e8" stroke-opacity=".4" stroke-width="1"/>
          <path d="M6 19L18 6" stroke="#8febf5" stroke-width="2" stroke-linecap="round"/>
          <path d="M13 6L18 6L18 11" stroke="#f0c674" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div class="hs-logo-text">SKIRK<span>SHOP</span></div>
      </div>

      <div class="hs-stage">
        <svg class="hs-rune" viewBox="0 0 300 300" fill="none">
          <circle cx="150" cy="150" r="118" stroke="#9b6fe0" stroke-width="1"/>
          <circle cx="150" cy="150" r="128" stroke="#4fd8e8" stroke-width=".6" stroke-dasharray="2 6"/>
          <g stroke="#9b6fe0" stroke-width="1">
            <line x1="150" y1="22" x2="150" y2="34"/>
            <line x1="150" y1="266" x2="150" y2="278"/>
            <line x1="22" y1="150" x2="34" y2="150"/>
            <line x1="266" y1="150" x2="278" y2="150"/>
            <line x1="61" y1="61" x2="70" y2="70"/>
            <line x1="230" y1="230" x2="239" y2="239"/>
            <line x1="61" y1="239" x2="70" y2="230"/>
            <line x1="230" y1="70" x2="239" y2="61"/>
          </g>
        </svg>
        <svg class="hs-rune-inner" viewBox="0 0 224 224" fill="none">
          <polygon points="112,10 205,168 19,168" stroke="#4fd8e8" stroke-width="1" stroke-opacity=".6"/>
          <circle cx="112" cy="112" r="70" stroke="#f0c674" stroke-width=".6" stroke-opacity=".5"/>
        </svg>

        <div class="hs-mascot-wrap">
          <svg width="170" height="215" viewBox="0 0 190 240" fill="none">
            <polygon points="78,80 128,82 145,150 155,228 25,232 15,150" fill="#160c28" stroke="#3a2464" stroke-width="1"/>
            <polygon points="108,46 135,60 128,110 112,66" fill="#2a1a4a"/>
            <polygon points="72,86 118,86 105,150 130,225 60,225 85,150" fill="#1d1236" stroke="#4c2f85" stroke-width="1"/>
            <polygon points="95,36 112,46 112,66 95,78 78,66 78,46" fill="#231a3d" stroke="#4c2f85" stroke-width="1"/>
            <polygon points="90,56 100,56 96,62 94,62" fill="#4fd8e8" opacity=".9"/>
            <polygon points="112,90 133,102 126,116 108,101" fill="#1d1236" stroke="#4c2f85" stroke-width="1"/>
            <polygon points="126,110 152,96 158,102 133,118" fill="#1d1236" stroke="#4c2f85" stroke-width="1"/>
            <polygon points="152,100 159,91 190,44 184,53" fill="#8febf5"/>
            <polyline points="153,99 158,92 189,46" fill="none" stroke="#e9fdff" stroke-width="1.4" stroke-linecap="round" class="hs-glint"/>
          </svg>
        </div>

        <svg class="hs-shard" style="top:16px; left:134px; width:10px; height:10px; animation-delay:.2s;" viewBox="0 0 10 10"><polygon points="5,0 10,5 5,10 0,5" fill="#8febf5" opacity=".8"/></svg>
        <svg class="hs-shard" style="top:86px; left:186px; width:7px; height:7px; animation-delay:1.4s;" viewBox="0 0 10 10"><polygon points="5,0 10,5 5,10 0,5" fill="#9b6fe0" opacity=".8"/></svg>
        <svg class="hs-shard" style="top:186px; left:34px; width:8px; height:8px; animation-delay:2.2s;" viewBox="0 0 10 10"><polygon points="5,0 10,5 5,10 0,5" fill="#f0c674" opacity=".8"/></svg>
        <svg class="hs-shard" style="top:44px; left:224px; width:6px; height:6px; animation-delay:.8s;" viewBox="0 0 10 10"><polygon points="5,0 10,5 5,10 0,5" fill="#4fd8e8" opacity=".8"/></svg>
      </div>

      <div class="hs-content">
        <div class="hs-eyebrow"><i></i>TOP UP GAME ONLINE</div>
        <div class="hs-headline">TOP UP DI<br><span class="hs-accent">SKIRK SHOP</span></div>
        <p class="hs-subtext">Voucher &amp; diamond semua game favoritmu — <b>aman &amp; mudah</b>, terkirim instan kapan pun kamu butuh.</p>
        <a href="#catTabs" class="hs-cta" onclick="event.preventDefault(); document.getElementById('catTabs').scrollIntoView({behavior:'smooth', block:'start'});">Mulai Top Up
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <div class="hs-badges">
          <div class="hs-badge"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3L4 6V11C4 16 7.4 20.4 12 21C16.6 20.4 20 16 20 11V6L12 3Z" stroke="currentColor" stroke-width="2"/><path d="M9 12L11 14L15 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Pembayaran Aman</div>
          <div class="hs-badge"><svg viewBox="0 0 24 24" fill="none"><path d="M13 2L4 14H11L10 22L20 9H13L13 2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>Proses Instan</div>
          <div class="hs-badge"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 7V12L15.5 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>Support 24 Jam</div>
        </div>
      </div>
    </div>

    <!-- ====== BANNER SLIDER ====== -->
    <% if (banners && banners.length > 0) { %>
    <div class="banner-slider" id="bannerSlider">
      <div class="banner-track" id="bannerTrack">
        <% banners.forEach((b, i) => { %>
          <% if (b.link) { %>
            <a href="<%= b.link %>" class="banner-slide" target="<%= b.link.startsWith('http') ? '_blank' : '_self' %>" rel="noopener">
              <img src="<%= b.image %>" alt="<%= b.title || 'Banner' %>" loading="<%= i === 0 ? 'eager' : 'lazy' %>">
              <% if (b.title) { %><div class="banner-caption"><%= b.title %></div><% } %>
            </a>
          <% } else { %>
            <div class="banner-slide">
              <img src="<%= b.image %>" alt="<%= b.title || 'Banner' %>" loading="<%= i === 0 ? 'eager' : 'lazy' %>">
              <% if (b.title) { %><div class="banner-caption"><%= b.title %></div><% } %>
            </div>
          <% } %>
        <% }) %>
      </div>
      <% if (banners.length > 1) { %>
        <div class="banner-dots" id="bannerDots">
          <% banners.forEach((b, i) => { %>
            <span class="banner-dot <%= i === 0 ? 'active' : '' %>" data-idx="<%= i %>"></span>
          <% }) %>
        </div>
      <% } %>
    </div>
    <% } %>

    <!-- ====== TAB KATEGORI (filter produk per kategori, tanpa reload) ====== -->
    <div class="cat-tabs" id="catTabs">
      <button type="button" class="cat-tab active" data-cat="all"><i class="fa-solid fa-table-cells-large"></i> Semua</button>
      <% rows.forEach(row => { %>
        <button type="button" class="cat-tab" data-cat="<%= row.category %>"><i class="fa-solid fa-gamepad"></i> <%= row.category %></button>
      <% }) %>
    </div>

    <!-- ====== SEARCH PRODUK (pill + tombol bulat) ====== -->
    <div class="catalog-search-bar">
      <input type="text" id="produkSearchInput" placeholder="Cari produk atau game...">
      <button type="button" class="catalog-search-btn" id="catalogSearchBtn" aria-label="Cari produk"><i class="fa-solid fa-magnifying-glass"></i></button>
    </div>

    <div id="produkSearchEmpty" class="card empty-state" style="display:none;">Produk "<span id="produkSearchEmptyTerm"></span>" tidak ditemukan.</div>

    <!-- ====== TEKS BERJALAN (MARQUEE) ====== -->
    <% if (marquee && marquee.enabled !== false && marquee.text) { %>
    <div class="marquee-wrap">
      <div class="marquee-label"><i class="fa-solid fa-bullhorn"></i></div>
      <div class="marquee-track">
        <div class="marquee-content" id="marqueeContent">
          <%= marquee.text %>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<%= marquee.text %>
        </div>
      </div>
    </div>
    <% } %>

    <!-- ====== FLASH SALE (carousel geser, harga sama semua role) ====== -->
    <%- include('partials/flashsale-carousel', { flashSaleItems, flashSaleSettings }) %>

    <!-- ====== 6 KATEGORI BESTSELLER (carousel geser, ranking Terjual asli) ====== -->
    <%- include('partials/bestseller-carousel', { bestsellers }) %>

    <% if (!user) { %>
      <div class="alert guest-alert"><i class="fa-solid fa-hand"></i> Kamu sedang menjelajah sebagai <b>Tamu</b>. Silakan <a href="/login" style="color:var(--cyan); text-decoration:underline;">masuk</a> atau <a href="/register" style="color:var(--cyan); text-decoration:underline;">daftar</a> untuk melakukan pemesanan.</div>
    <% } %>

    <% if (memberDiscount > 0) { %>
      <div class="alert member-alert">
        <i class="fa-solid <%= user.membership === 'platinum' ? 'fa-gem' : 'fa-medal' %>"></i> Kamu member <b><%= user.membership %></b>, potongan <b><%= memberDiscount %>%</b> di setiap pembelian
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>

    <!-- Katalog produk per kategori -->
    <% if (products.length === 0) { %>
      <div class="card empty-state">Belum ada produk tersedia saat ini.</div>
    <% } else { %>
      <% rows.forEach(row => { %>
        <div class="nf-row" data-row data-category="<%= row.category %>">
          <div class="nf-row-title"><i class="fa-solid fa-gamepad"></i> <%= row.category %></div>
          <div class="nf-row-track">
            <% row.products.forEach((p, idx) => { %>
              <a href="/produk/<%= slugify(p.variantGroup || p.name) %>" class="nf-card nf-card-link game-card <%= idx >= 9 ? 'nf-card-extra' : '' %>" data-name="<%= p.name.toLowerCase() %>">
                <div class="nf-card-thumb">
                  <% if (p.thumbnail) { %><img src="<%= p.thumbnail %>" alt="<%= p.name %>" loading="lazy" onload="this.classList.add('is-loaded')"><% } else { %><span class="nf-noimg"><%= p.name.slice(0,1) %></span><% } %>
                  <% if (p.isVariantGroup) { %>
                    <span class="nf-stock-tag ok"><%= p.variantCount %> pilihan</span>
                  <% } else { %>
                    <% /* Produk Digiflazz dikirim otomatis oleh sistem, jadi selalu dianggap tersedia — gak ngandelin stockItems manual yang memang sengaja kosong. */ %>
                    <% const isAuto = p.provider === 'digiflazz'; %>
                    <% const stockCount = p.stockItems ? p.stockItems.length : 0; %>
                    <% const available = isAuto || stockCount > 0; %>
                    <span class="nf-stock-tag <%= available ? 'ok' : 'warn' %>"><%- available ? '<i class="fa-solid fa-bolt"></i>' : '<i class="fa-solid fa-screwdriver-wrench"></i>' %></span>
                  <% } %>
                  <% if (p.gamePreset && p.gamePreset !== 'none') { %><span class="game-icon-badge"><i class="fa-solid <%= p.icon %>"></i></span><% } %>
                </div>
                <div class="nf-card-body">
                  <div class="nf-card-name"><%= p.name %></div>
                  <div class="nf-rating">
                    <% const r = Math.round(p.rating || 0); for(let i=1;i<=5;i++){ %><span class="nf-star <%= i<=r?'on':'' %>">★</span><% } %>
                    <span class="nf-rating-num"><%= (p.rating||0).toFixed(1) %></span>
                    <% if (p.totalSold) { %><span class="nf-sold"><%= p.totalSold %> terjual</span><% } %>
                  </div>
                  <div class="nf-card-price">
                    <% if (p.isVariantGroup) { %>
                      <span class="nf-price-now">Rp <%= p.finalPrice.toLocaleString('id-ID') %></span>
                    <% } else { %>
                      <span class="nf-price-now">Rp <%= p.finalPrice.toLocaleString('id-ID') %></span>
                    <% } %>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>
          <% if (row.products.length > 9) { %>
            <button type="button" class="nf-row-more" data-total="<%= row.products.length %>">
              <span class="nf-row-more-text">Lihat Semua (<%= row.products.length %>)</span>
              <i class="fa-solid fa-chevron-down nf-row-more-icon"></i>
            </button>
          <% } %>
        </div>
      <% }) %>
    <% } %>

    <%- include('partials/footer') %>
  </div>
</div>

<script>
// ===== BANNER SLIDER =====
(function () {
  var track = document.getElementById('bannerTrack');
  var dots = document.querySelectorAll('.banner-dot');
  if (!track) return;

  var slides = track.querySelectorAll('.banner-slide');
  var total = slides.length;
  if (total <= 1) return;

  var current = 0;
  var autoTimer;

  function goTo(idx) {
    current = (idx + total) % total;
    track.style.transform = 'translateX(-' + (current * 100) + '%)';
    dots.forEach(function (d, i) { d.classList.toggle('active', i === current); });
  }

  function next() { goTo(current + 1); }
  function prev() { goTo(current - 1); }

  function resetAuto() {
    clearInterval(autoTimer);
    autoTimer = setInterval(next, 4500);
  }

  dots.forEach(function (d) {
    d.addEventListener('click', function () { goTo(parseInt(d.dataset.idx)); resetAuto(); });
  });

  // Touch swipe
  var startX = 0;
  track.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
  track.addEventListener('touchend', function (e) {
    var diff = startX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) { diff > 0 ? next() : prev(); resetAuto(); }
  }, { passive: true });

  resetAuto();
})();

// ===== TAB KATEGORI (filter produk per kategori, tanpa reload) =====
(function () {
  var tabs = document.querySelectorAll('.cat-tab');
  var rows = document.querySelectorAll('[data-row]');
  var searchInput = document.getElementById('produkSearchInput');
  if (!tabs.length) return;

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      tabs.forEach(function (t) { t.classList.remove('active'); });
      tab.classList.add('active');

      // Pindah tab = mulai dari tampilan bersih, biar gak ketimpa sisa filter search sebelumnya
      if (searchInput) searchInput.value = '';
      var emptyBox = document.getElementById('produkSearchEmpty');
      if (emptyBox) emptyBox.style.display = 'none';

      var cat = tab.dataset.cat;
      rows.forEach(function (row) {
        row.style.display = (cat === 'all' || row.dataset.category === cat) ? '' : 'none';
        row.querySelectorAll('.nf-card').forEach(function (card) { card.style.display = ''; });
        // Balik ke kondisi terlipat tiap ganti tab, biar konsisten kayak baru buka halaman
        row.classList.remove('expanded');
        var moreBtn = row.querySelector('.nf-row-more');
        if (moreBtn) {
          moreBtn.style.display = '';
          var textEl = moreBtn.querySelector('.nf-row-more-text');
          if (textEl) textEl.textContent = 'Lihat Semua (' + moreBtn.dataset.total + ')';
        }
      });
    });
  });
})();

// ===== SEARCH PRODUK (live filter, tanpa reload) =====
(function () {
  var input = document.getElementById('produkSearchInput');
  if (!input) return;
  var rows = document.querySelectorAll('[data-row]');
  var emptyBox = document.getElementById('produkSearchEmpty');
  var emptyTerm = document.getElementById('produkSearchEmptyTerm');
  var tabs = document.querySelectorAll('.cat-tab');
  var searchBtn = document.getElementById('catalogSearchBtn');
  if (searchBtn) searchBtn.addEventListener('click', function () { input.focus(); });

  input.addEventListener('input', function () {
    var q = input.value.trim().toLowerCase();
    var totalVisible = 0;

    // Lagi ngetik cari = jelajah lintas kategori, jadi tab balik ke "Semua"
    if (q && tabs.length) {
      tabs.forEach(function (t) { t.classList.toggle('active', t.dataset.cat === 'all'); });
    }

    rows.forEach(function (row) {
      var cards = row.querySelectorAll('.nf-card');
      var visibleInRow = 0;
      cards.forEach(function (card) {
        var match = !q || (card.dataset.name || '').includes(q);
        card.style.display = match ? '' : 'none';
        if (match) { visibleInRow++; totalVisible++; }
      });
      row.style.display = visibleInRow > 0 ? '' : 'none';

      // Lagi search = buka semua lipatan biar produk yang ketutup fold ikut ketemu;
      // pas kotak pencarian dikosongkan lagi, balik ke kondisi terlipat (default) lagi.
      row.classList.toggle('expanded', !!q);
      var moreBtn = row.querySelector('.nf-row-more');
      if (moreBtn) {
        moreBtn.style.display = q ? 'none' : '';
        if (!q) {
          var textEl = moreBtn.querySelector('.nf-row-more-text');
          if (textEl) textEl.textContent = 'Lihat Semua (' + moreBtn.dataset.total + ')';
        }
      }
    });

    if (emptyBox) {
      emptyBox.style.display = (q && totalVisible === 0) ? '' : 'none';
      if (emptyTerm) emptyTerm.textContent = input.value.trim();
    }
  });
})();

// ===== LIPAT / TAMPILKAN SEMUA per kategori (3 kolom x 3 baris dulu) =====
(function () {
  var moreButtons = document.querySelectorAll('.nf-row-more');
  moreButtons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var row = btn.closest('.nf-row');
      if (!row) return;
      var expanded = row.classList.toggle('expanded');
      var textEl = btn.querySelector('.nf-row-more-text');
      if (textEl) textEl.textContent = expanded ? 'Tampilkan Lebih Sedikit' : ('Lihat Semua (' + btn.dataset.total + ')');
      if (!expanded) {
        // Balik ke tampilan rapi: scroll dikit ke atas biar user gak "kehilangan" posisi row ini
        row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  });
})();
</script>
</body>
</html>
