<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head') %></head>
<body>
  <div class="auth-split">
    <div class="auth-split-brand">
      <div class="auth-split-brand-inner">
        <div class="auth-split-logo"><i class="fa-solid fa-bolt"></i> <%= config.siteName %></div>
        <div class="auth-split-tagline"><%= config.siteTagline || 'Top Up Game & PPOB Termurah, Proses Otomatis 24 Jam' %></div>
        <ul class="auth-split-features">
          <li><i class="fa-solid fa-envelope-circle-check"></i> Cek kotak masuk (& folder spam)</li>
          <li><i class="fa-solid fa-clock"></i> Kode OTP berlaku 10 menit</li>
          <li><i class="fa-solid fa-lock"></i> Jangan bagikan kode ke siapa pun</li>
        </ul>
      </div>
    </div>

    <div class="auth-split-form-side">
      <div class="auth-card auth-card-split">
        <h1 class="auth-title"><i class="fa-solid fa-shield-halved"></i> Masukkan Kode OTP</h1>
        <div class="auth-sub">Kode 6 digit sudah dikirim ke email kamu</div>

        <% if (sent && !error) { %><div class="alert success">Kalau email itu terdaftar, kode OTP sudah dikirim. Cek kotak masuk/spam.</div><% } %>
        <% if (error) { %><div class="alert error"><%= error %></div><% } %>

        <form method="POST" action="/reset-password">
          <label>Email</label>
          <div class="auth-input-group">
            <i class="fa-solid fa-envelope"></i>
            <input type="email" name="email" required value="<%= prefillEmail %>" placeholder="Email akun kamu">
          </div>
          <label>Kode OTP</label>
          <div class="auth-input-group">
            <i class="fa-solid fa-key"></i>
            <input type="text" name="otp" required inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="6 digit kode dari email" style="letter-spacing:4px; font-weight:700;">
          </div>
          <label>Password Baru</label>
          <div class="auth-input-group">
            <i class="fa-solid fa-lock"></i>
            <input type="password" name="password" required minlength="6" placeholder="Minimal 6 karakter">
          </div>
          <label>Konfirmasi Password Baru</label>
          <div class="auth-input-group">
            <i class="fa-solid fa-lock"></i>
            <input type="password" name="password2" required minlength="6" placeholder="Ulangi password baru">
          </div>
          <button class="btn solid mt-24" type="submit" style="width:100%;"><i class="fa-solid fa-rotate"></i> Ganti Password</button>
        </form>

        <div class="auth-footer">
          Belum dapat kode? <a href="/lupa-password">Kirim ulang</a><br>
          <a href="/login">← Kembali ke Login</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
